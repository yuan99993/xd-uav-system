<?xml version="1.0"?>
<launch>
  <arg name="UAV_NAME" default="uav1"/>
  <arg name="plane_sdf"
       default="$(find px4)/Tools/sitl_gazebo/models/plane/plane.sdf.jinja"/>
  <arg name="world"
       default="$(find px4)/Tools/sitl_gazebo/worlds/empty.world"/>
  <arg name="fcu_url" default="udp://:14540@localhost:14557"/>
  <arg name="gui" default="false"/>
  <arg name="run_acceptance" default="true"/>
  <arg name="path_length" default="180.0"/>
  <arg name="enable_nofly" default="false"/>
  <arg name="dynamic_nofly" default="false"/>
  <arg name="dynamic_insert_fraction" default="0.08"/>
  <arg name="dynamic_remove_fraction" default="0.20"/>
  <arg name="dynamic_remove_margin" default="5.0"/>
  <arg name="zone_id" default="7101"/>
  <arg name="zone_center_fraction" default="0.25"/>
  <arg name="zone_half_size" default="10.0"/>
  <arg name="zone_clearance" default="10.0"/>
  <arg name="turning_radius" default="35.0"/>
  <arg name="visualize" default="false"/>
  <!-- Automated acceptance must not couple PX4 lifetime to terminal stdin. -->
  <arg name="interactive" default="false"/>

  <env name="GAZEBO_MODEL_PATH"
       value="$(find px4)/Tools/sitl_gazebo/models:$(optenv GAZEBO_MODEL_PATH)"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
  </include>
  <include file="$(find xd_uav_control_manager)/launch/sitl/px4_sitl_vehicle.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="vehicle" value="plane"/>
    <arg name="sdf_source" value="$(arg plane_sdf)"/>
    <arg name="mavros_fcu_url" value="$(arg fcu_url)"/>
    <arg name="interactive" value="$(arg interactive)"/>
    <!-- The Plane estimator contract consumes the FCU body frame directly;
         multirotor fixtures keep the shared launch's base_link default. -->
    <arg name="imu_frame_id" value="$(arg UAV_NAME)/fcu"/>
  </include>
  <include file="$(find xd_uav_state_estimators)/launch/odometry_adapter_manager.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="sources_config"
         value="$(find xd_uav_planning)/config/demo/fixedwing_mavros_sources.yaml"/>
  </include>
  <include file="$(find xd_uav_state_estimators)/launch/estimator.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="sources_config"
         value="$(find xd_uav_planning)/config/demo/fixedwing_mavros_sources.yaml"/>
    <arg name="body_frame" value="$(arg UAV_NAME)/fcu"/>
  </include>
  <include file="$(find xd_uav_control_manager)/launch/fixedwing_system.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="controller_common_config"
         value="$(find xd_uav_controller)/config/common_config.yaml"/>
    <arg name="controller_config"
         value="$(find xd_uav_controller)/config/fixedwing.yaml"/>
    <arg name="offboard_config"
         value="$(find xd_uav_planning)/config/demo/fixedwing_offboard.yaml"/>
    <arg name="safety_config"
         value="$(find xd_uav_planning)/config/demo/fixedwing_sitl_safety.yaml"/>
  </include>
  <include file="$(find xd_uav_planning)/launch/planning.launch">
    <arg name="vehicle_type" value="fixedwing"/>
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="common_frame" value="$(arg UAV_NAME)/odom"/>
    <arg name="fixedwing_turning_radius" value="$(arg turning_radius)"/>
    <arg name="fixedwing_zone_clearance" value="$(arg zone_clearance)"/>
  </include>
  <node if="$(arg run_acceptance)" pkg="xd_uav_planning"
        type="fixedwing_path_acceptance.py" name="fixedwing_path_acceptance"
        output="screen" required="false">
    <param name="uav_name" value="$(arg UAV_NAME)"/>
    <param name="path_length" value="$(arg path_length)"/>
    <param name="enable_nofly" value="$(arg enable_nofly)"/>
    <param name="dynamic_nofly" value="$(arg dynamic_nofly)"/>
    <param name="dynamic_insert_fraction" value="$(arg dynamic_insert_fraction)"/>
    <param name="dynamic_remove_fraction" value="$(arg dynamic_remove_fraction)"/>
    <param name="dynamic_remove_margin" value="$(arg dynamic_remove_margin)"/>
    <param name="zone_id" value="$(arg zone_id)"/>
    <param name="zone_center_fraction" value="$(arg zone_center_fraction)"/>
    <param name="zone_half_size" value="$(arg zone_half_size)"/>
    <param name="zone_clearance" value="$(arg zone_clearance)"/>
  </node>
  <node if="$(arg visualize)" pkg="xd_uav_planning"
        type="fixedwing_nofly_visualizer.py" name="fixedwing_nofly_visualizer"
        output="screen" required="false">
    <param name="uav_name" value="$(arg UAV_NAME)"/>
  </node>
</launch>
