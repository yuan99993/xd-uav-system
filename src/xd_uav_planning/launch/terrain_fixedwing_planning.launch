<?xml version="1.0"?>
<launch>
  <!-- Terrain-aware fixed-wing planning composition. This launch owns only
       the planning chain; a deployment starts the controller and manager
       separately. It never arms or requests takeoff. -->
  <arg name="UAV_NAME" default="$(optenv UAV_NAME uav1)"/>
  <arg name="common_frame" default="world"/>
  <arg name="map_path"
       default="$(find terrain_navigation)/../resources/davosdorf.tif"/>
  <arg name="terrain_config"
       default="$(find xd_uav_planning)/config/terrain_planner.yaml"/>

  <arg name="task_path_topic" default="planning/task_path"/>
  <arg name="terrain_path_topic" default="planning/terrain_path"/>
  <arg name="terrain_status_topic" default="planning/terrain_status"/>
  <arg name="backend_status_topic" default="planning/backend_status"/>
  <arg name="planner_status_topic" default="planning/status"/>
  <arg name="healthy_topic" default="planning/healthy"/>
  <arg name="diagnostics_topic" default="planning/diagnostics"/>
  <arg name="adjusted_path_topic" default="planning/adjusted_path"/>
  <!-- Terrain validation happens before the existing no-fly backend. Keep its
       path mutation isolated until the adjusted result is terrain-validated. -->
  <arg name="no_fly_zones_topic"
       default="planning/terrain_no_fly_zones_disabled"/>
  <arg name="no_fly_zone_markers_topic"
       default="/planning/no_fly_zone_markers"/>

  <!-- One value configures both the upstream Dubins-Airplane solver and the
       downstream no-fly adjustment, preventing a weaker downstream turn. -->
  <arg name="minimum_turning_radius_m" default="66.66667"/>
  <arg name="terrain_elevation_offset_m" default="0.0"/>
  <arg name="terrain_random_seed" default="0"/>
  <arg name="terrain_solve_time_per_leg_s" default="5.0"/>
  <arg name="terrain_maximum_solve_attempts" default="1"/>
  <arg name="zone_clearance_m" default="15.0"/>
  <arg name="planning_sample_step_m" default="2.0"/>
  <arg name="dynamic_failure_cancel_service"
       default="control_manager/cancel_offboard"/>

  <include file="$(find xd_uav_planning)/launch/internal/terrain_planner.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="common_frame" value="$(arg common_frame)"/>
    <arg name="map_path" value="$(arg map_path)"/>
    <arg name="config" value="$(arg terrain_config)"/>
    <arg name="request_topic" value="$(arg task_path_topic)"/>
    <arg name="output_topic" value="$(arg terrain_path_topic)"/>
    <arg name="status_topic" value="$(arg terrain_status_topic)"/>
    <arg name="minimum_turning_radius_m"
         value="$(arg minimum_turning_radius_m)"/>
    <arg name="terrain_elevation_offset_m"
         value="$(arg terrain_elevation_offset_m)"/>
    <arg name="random_seed" value="$(arg terrain_random_seed)"/>
    <arg name="solve_time_per_leg_s"
         value="$(arg terrain_solve_time_per_leg_s)"/>
    <arg name="maximum_solve_attempts"
         value="$(arg terrain_maximum_solve_attempts)"/>
  </include>

  <include file="$(find xd_uav_planning)/launch/internal/fixedwing_path_backend.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="common_frame" value="$(arg common_frame)"/>
    <arg name="task_path_topic" value="$(arg terrain_path_topic)"/>
    <arg name="planner_status_topic" value="$(arg backend_status_topic)"/>
    <arg name="healthy_topic" value="$(arg healthy_topic)"/>
    <arg name="diagnostics_topic" value="$(arg diagnostics_topic)"/>
    <arg name="no_fly_zones_topic" value="$(arg no_fly_zones_topic)"/>
    <arg name="no_fly_zone_markers_topic"
         value="$(arg no_fly_zone_markers_topic)"/>
    <arg name="adjusted_path_topic" value="$(arg adjusted_path_topic)"/>
    <arg name="turning_radius" value="$(arg minimum_turning_radius_m)"/>
    <arg name="zone_clearance" value="$(arg zone_clearance_m)"/>
    <arg name="planning_sample_step" value="$(arg planning_sample_step_m)"/>
    <arg name="dynamic_failure_cancel_service"
         value="$(arg dynamic_failure_cancel_service)"/>
  </include>

  <group ns="$(arg UAV_NAME)">
    <node pkg="xd_uav_planning"
          type="terrain_status_coordinator.py"
          name="terrain_status_coordinator"
          output="screen"
          required="true">
      <param name="terrain_status_topic" value="$(arg terrain_status_topic)"/>
      <param name="backend_status_topic" value="$(arg backend_status_topic)"/>
      <param name="planner_status_topic" value="$(arg planner_status_topic)"/>
    </node>
  </group>
</launch>
