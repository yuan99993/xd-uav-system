<?xml version="1.0"?>
<launch>
  <arg name="UAV_NAME" default="$(optenv UAV_NAME uav1)"/>
  <arg name="uav_name" default="$(arg UAV_NAME)"/>
  <arg name="common_frame" default="world"/>
  <arg name="config"
       default="$(find xd_uav_planning)/config/fixedwing_path.yaml"/>
  <arg name="task_path_topic" default="planning/task_path"/>
  <arg name="planner_status_topic" default="planning/status"/>
  <arg name="healthy_topic" default="planning/healthy"/>
  <arg name="diagnostics_topic" default="planning/diagnostics"/>
  <arg name="no_fly_zones_topic" default="/planning/no_fly_zones"/>
  <arg name="no_fly_zone_markers_topic" default="/planning/no_fly_zone_markers"/>
  <arg name="adjusted_path_topic" default="planning/adjusted_path"/>
  <arg name="turning_radius" default="35.0"/>
  <arg name="zone_clearance" default="15.0"/>
  <arg name="planning_sample_step" default="2.0"/>
  <arg name="dynamic_failure_cancel_service"
       default="control_manager/cancel_offboard"/>

  <group ns="$(arg uav_name)">
    <node pkg="xd_uav_planning"
          type="fixedwing_path_backend_node.py"
          name="fixedwing_path_backend"
          output="screen"
          required="true">
      <rosparam command="load" file="$(arg config)"/>
      <param name="common_frame" value="$(arg common_frame)"/>
      <param name="task_path_topic" value="$(arg task_path_topic)"/>
      <param name="planner_status_topic" value="$(arg planner_status_topic)"/>
      <param name="state_topic" value="control_manager/state"/>
      <param name="controller_path_topic" value="control/reference/path"/>
      <param name="controller_setpoint_topic" value="control/reference/setpoint"/>
      <param name="controller_path_status_topic" value="controller/path_status"/>
      <param name="cancel_service" value="planning/cancel"/>
      <param name="healthy_topic" value="$(arg healthy_topic)"/>
      <param name="diagnostics_topic" value="$(arg diagnostics_topic)"/>
      <param name="no_fly_zones_topic" value="$(arg no_fly_zones_topic)"/>
      <param name="no_fly_zone_markers_topic"
             value="$(arg no_fly_zone_markers_topic)"/>
      <param name="adjusted_path_topic" value="$(arg adjusted_path_topic)"/>
      <param name="turning_radius" value="$(arg turning_radius)"/>
      <param name="zone_clearance" value="$(arg zone_clearance)"/>
      <param name="planning_sample_step" value="$(arg planning_sample_step)"/>
      <param name="dynamic_failure_cancel_service"
             value="$(arg dynamic_failure_cancel_service)"/>
    </node>
  </group>
</launch>
