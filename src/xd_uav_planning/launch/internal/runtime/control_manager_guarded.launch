<?xml version="1.0"?>
<launch>
  <arg name="UAV_NAME" default="uav1"/>
  <group ns="$(arg UAV_NAME)">
    <node pkg="xd_uav_control_manager" type="control_manager_node"
          name="control_manager" output="screen" clear_params="true">
      <rosparam command="load"
                file="$(find xd_uav_control_manager)/config/offboard.yaml"/>
      <rosparam command="load"
                file="$(find xd_uav_control_manager)/config/safety.yaml"/>
      <param name="vehicle_type" value="multirotor"/>
      <remap from="main_odometry" to="state_estimator/main/odom"/>
      <remap from="main_acceleration" to="state_estimator/main/acceleration"/>
      <remap from="estimator_status" to="state_estimator/status"/>
      <remap from="imu" to="integration/imu_base_link"/>
      <remap from="airspeed" to="mavros/vfr_hud"/>
      <remap from="mavros_state" to="mavros/state"/>
      <remap from="mavros_extended_state" to="mavros/extended_state"/>
      <remap from="controller_command" to="controller/command"/>
      <remap from="attitude_target" to="mavros/setpoint_raw/attitude"/>
      <remap from="set_mode" to="mavros/set_mode"/>
      <remap from="arming" to="mavros/cmd/arming"/>
      <remap from="command_long" to="mavros/cmd/command"/>
      <remap from="controller_internal_command" to="controller/internal/command"/>
    </node>
  </group>
</launch>
