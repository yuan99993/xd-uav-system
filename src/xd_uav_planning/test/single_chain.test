<launch>
  <arg name="evidence_path"
       default="/tmp/xd_uav_ego_single_chain_result.json" />

  <include file="$(find ego_planner)/launch/advanced_param.xml">
    <arg name="drone_id" value="0" />
    <arg name="map_size_x_" value="20.0" />
    <arg name="map_size_y_" value="12.0" />
    <arg name="map_size_z_" value="5.0" />
    <arg name="odometry_topic" value="synthetic/odom" />
    <arg name="obj_num_set" value="0" />
    <arg name="camera_pose_topic" value="synthetic/camera_pose" />
    <arg name="depth_topic" value="synthetic/depth" />
    <arg name="cloud_topic" value="synthetic/cloud" />
    <arg name="cx" value="321.0" />
    <arg name="cy" value="243.0" />
    <arg name="fx" value="387.0" />
    <arg name="fy" value="387.0" />
    <arg name="max_vel" value="1.0" />
    <arg name="max_acc" value="2.0" />
    <arg name="planning_horizon" value="7.5" />
    <arg name="use_distinctive_trajs" value="false" />
    <arg name="flight_type" value="1" />
    <arg name="point_num" value="1" />
    <arg name="point0_x" value="6.0" />
    <arg name="point0_y" value="0.0" />
    <arg name="point0_z" value="2.0" />
    <arg name="point1_x" value="0.0" />
    <arg name="point1_y" value="0.0" />
    <arg name="point1_z" value="2.0" />
    <arg name="point2_x" value="0.0" />
    <arg name="point2_y" value="0.0" />
    <arg name="point2_z" value="2.0" />
    <arg name="point3_x" value="0.0" />
    <arg name="point3_y" value="0.0" />
    <arg name="point3_z" value="2.0" />
    <arg name="point4_x" value="0.0" />
    <arg name="point4_y" value="0.0" />
    <arg name="point4_z" value="2.0" />
  </include>

  <node pkg="ego_planner" name="drone_0_traj_server"
        type="traj_server" output="screen" required="true">
    <remap from="position_cmd" to="/e2/raw_position_command" />
    <remap from="~planning/bspline" to="/drone_0_planning/bspline" />
    <param name="traj_server/time_forward" value="0.0" />
  </node>

  <group ns="uav1">
    <node pkg="xd_uav_planning" type="ego_bridge_node.py"
          name="ego_bridge" output="screen" required="true">
      <param name="common_frame" value="world" />
      <param name="body_frame" value="uav1/base_link" />
      <param name="state_timeout" value="0.2" />
      <param name="command_timeout" value="0.2" />
      <param name="odometry_topic" value="/drone_0_synthetic/odom" />
      <param name="position_command_topic" value="/e2/position_command" />
    </node>
  </group>

  <test test-name="single_chain" pkg="xd_uav_planning"
        type="test_single_chain.py" time-limit="45">
    <param name="evidence_path" value="$(arg evidence_path)" />
  </test>
</launch>
