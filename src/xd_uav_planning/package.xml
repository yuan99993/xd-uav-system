<?xml version="1.0"?>
<package format="2">
  <name>xd_uav_planning</name>
  <version>0.1.0</version>
  <description>Unified XD-UAV planning layer with EGO-Swarm multirotor and fixed-wing path backends.</description>

  <maintainer email="kzy@example.com">kzy</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>xd_uav_controller</depend>
  <depend>xd_uav_task_allocate</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>ego_planner</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>px4</exec_depend>
  <exec_depend>xd_uav_control_manager</exec_depend>
  <exec_depend>xd_uav_state_estimators</exec_depend>
  <exec_depend>xd_uav_system_integration</exec_depend>

  <!-- Optional at workspace-build time; required only when the node is run. -->
  <exec_depend>quadrotor_msgs</exec_depend>
  <test_depend>python3-nose</test_depend>
  <test_depend>rostest</test_depend>
  <test_depend>traj_utils</test_depend>

  <export/>
</package>
