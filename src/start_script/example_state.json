{
  "action": "start",
  "session_id": "sim_run_001",
  "profile": "vtol",
  "shared_launches": ["world_tf"],
  "vehicles": [
    {
      "name": "uav1",
      "type": "vtol",
      "track_sensor": "front",
      "sensors": [
        {
          "id": "front",
          "type": "front_gimbal_camera",
          "params": {
            "sensor_id": "front_gimbal",
            "image_topic": "/Sim/SceneBasicDrone/robots/Drone1/sensors/FrontCamera/scene_camera/image",
            "camera_info_topic": "/Sim/SceneBasicDrone/robots/Drone1/sensors/FrontCamera/scene_camera/camera_info",
            "image_width": 1280,
            "image_height": 720,
            "range_topic": "/Sim/SceneBasicDrone/robots/Drone1/sensors/FrontDistance/distance_sensor",
            "gimbal_att_topic": "/uav1/gimbal/attitude"
          }
        },
        {
          "id": "down",
          "type": "down_camera",
          "params": {
            "image_topic": "/Sim/SceneBasicDrone/robots/Drone1/sensors/DownCamera/scene_camera/image",
            "camera_info_topic": "/Sim/SceneBasicDrone/robots/Drone1/sensors/DownCamera/scene_camera/camera_info",
            "image_width": 1280,
            "image_height": 720
          }
        }
      ],
      "launches": [
        "localization",
        "control",
        {"id": "sar_yolo_detector", "sensor": "front"},
        {"id": "gimbal_attitude_bridge", "sensor": "front"},
        {
          "id": "gimbal_control",
          "sensor": "front",
          "params": {
            "mode": "tracking",
            "detection_input": "tracked",
            "detection_topic": "/uav1/sar_yolo_detector/front/selected_tracked_detections",
            "stabilize": true
          }
        },
        {
          "id": "target_geolocation",
          "sensor": "front",
          "params": {
            "detection_topic": "/uav1/sar_yolo_detector/front/selected_tracked_detections"
          }
        }
      ]
    },
    {
      "name": "uav2",
      "type": "vtol",
      "track_sensor": "down",
      "sensors": [
        {
          "id": "down",
          "type": "down_camera",
          "params": {
            "image_topic": "/Sim/SceneBasicDrone/robots/Drone2/sensors/DownCamera/scene_camera/image",
            "camera_info_topic": "/Sim/SceneBasicDrone/robots/Drone2/sensors/DownCamera/scene_camera/camera_info",
            "image_width": 1280,
            "image_height": 720
          }
        }
      ],
      "launches": [
        "localization",
        "control",
        "task_execute",
        {"id": "detect", "sensor": "down"}
      ]
    }
  ]
}
