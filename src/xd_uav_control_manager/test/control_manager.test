<launch>
  <group ns="manager_test">
    <node pkg="xd_uav_control_manager"
          type="control_manager_node"
          name="control_manager"
          output="screen"
          clear_params="true">
      <param name="vehicle_type" value="multirotor"/>
      <param name="offboard/setpoint_rate" value="50.0"/>
      <param name="offboard/prestream_duration" value="0.1"/>
      <param name="offboard/request_retry_interval" value="0.05"/>
      <param name="offboard/request_timeout" value="3.0"/>
      <param name="safety/stable_duration" value="0.1"/>
      <param name="safety/invalid_grace_duration" value="0.3"/>
      <param name="safety/landed_confirm_duration" value="0.1"/>
      <param name="safety/touchdown_idle_duration" value="0.05"/>
      <param name="safety/allow_force_disarm" value="true"/>
      <param name="safety/force_disarm_timeout" value="0.2"/>
      <param name="safety/odometry_timeout" value="0.5"/>
      <param name="safety/imu_timeout" value="0.5"/>
      <param name="safety/acceleration_timeout" value="0.5"/>
      <param name="safety/airspeed_negative_tolerance" value="3.0"/>
      <param name="safety/command_timeout" value="0.5"/>
      <param name="safety/estimator_status_timeout" value="0.1"/>
    </node>
    <test test-name="control_manager_interface"
          pkg="xd_uav_control_manager"
          type="test_control_manager.py"
          time-limit="15"/>
  </group>
</launch>
