<?xml version="1.0"?>
<launch>
  <arg name="UAV_NAME" default="uav1"/>
  <arg name="sources_config"
       default="$(find xd_uav_control_manager)/config/sitl/px4_mavros_sources.yaml"/>
  <arg name="controller_override_config"
       default="$(find xd_uav_controller)/config/px4_iris_sitl.yaml"/>
  <arg name="simple_goal_topic" default="/move_base_simple/goal"/>

  <!-- The official PX4 Iris model exposes its rigid-body reference as fcu. -->
  <node pkg="tf2_ros" type="static_transform_publisher"
        name="px4_fcu_to_base_link"
        args="0 0 0 0 0 0 1 $(arg UAV_NAME)/base_link $(arg UAV_NAME)/fcu"/>

  <include file="$(find xd_uav_state_estimators)/launch/odometry_adapter_manager.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="sources_config" value="$(arg sources_config)"/>
  </include>
  <include file="$(find xd_uav_state_estimators)/launch/estimator.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="sources_config" value="$(arg sources_config)"/>
    <arg name="body_frame" value="$(arg UAV_NAME)/base_link"/>
  </include>
  <include file="$(find xd_uav_control_manager)/launch/multirotor_system.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="use_controller_override_config" value="true"/>
    <arg name="controller_override_config" value="$(arg controller_override_config)"/>
    <arg name="simple_goal_topic" value="$(arg simple_goal_topic)"/>
  </include>
</launch>
