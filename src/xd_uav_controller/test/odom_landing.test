<launch>
  <group ns="odom_landing_test">
    <node pkg="xd_uav_controller"
          type="controller_node"
          name="controller"
          output="screen"
          clear_params="true">
      <rosparam command="load"
                file="$(find xd_uav_controller)/config/common_config.yaml"/>
      <rosparam command="load"
                file="$(find xd_uav_controller)/config/multirotor.yaml"/>
      <param name="vehicle_type" value="multirotor"/>
      <param name="home/mode" value="takeoff"/>
      <param name="landing/height_source" value="odom"/>
      <param name="landing/odom_cfg/descent_velocity" value="2.0"/>
      <param name="landing/odom_cfg/final_descent_velocity"
             value="2.0"/>
    </node>
    <test test-name="odom_landing"
          pkg="xd_uav_controller"
          type="test_odom_landing.py"
          time-limit="12"/>
  </group>
</launch>
