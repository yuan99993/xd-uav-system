<?xml version="1.0"?>
<sdf version="1.7">
  <world name="mrs_city_simplified">
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>47.3977</latitude_deg>
      <longitude_deg>8.54559</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="default_physics" default="1" type="ode">
      <ode>
        <solver>
          <type>quick</type>
          <iters>10</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>1000</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <scene>
      <shadows>false</shadows>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
    </scene>
    <gravity>0 0 -9.8066</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- One light plus 18 physical models: 19 top-level Gazebo entities. -->
    <light name="sun" type="directional">
      <pose>0 0 1000 0.4 0.2 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <direction>0.1 0.1 -0.9</direction>
      <attenuation>
        <range>20</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>true</cast_shadows>
    </light>

    <include>
      <name>grass_plane</name>
      <uri>model://grass_plane</uri>
    </include>

    <!-- Four recognisable city blocks leave a clear central flight area. -->
    <include>
      <name>fire_station</name>
      <uri>model://fire_station</uri>
      <pose>38 34 0 0 0 3.14159</pose>
    </include>
    <include>
      <name>house_1</name>
      <uri>model://house_1</uri>
      <pose>-38 32 0 0 0 0</pose>
    </include>
    <include>
      <name>house_2</name>
      <uri>model://house_2</uri>
      <pose>40 -32 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>parking_garage</name>
      <uri>model://parking_garage</uri>
      <pose>-42 -34 0 0 0 0</pose>
    </include>

    <!-- Six walls form two side mazes. Keep x=-15..15 clear along +Y so the
         fixed-wing has a 30 m wide, 100 m long ground-roll corridor. -->
    <include>
      <name>wall_north</name>
      <uri>model://grey_wall</uri>
      <pose>-28 15 0 0 0 0</pose>
    </include>
    <include>
      <name>wall_south</name>
      <uri>model://grey_wall</uri>
      <pose>28 -15 0 0 0 0</pose>
    </include>
    <include>
      <name>wall_west</name>
      <uri>model://grey_wall</uri>
      <pose>-28 38 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>wall_east</name>
      <uri>model://grey_wall</uri>
      <pose>28 38 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>wall_gate_west</name>
      <uri>model://grey_wall</uri>
      <pose>-32 -4 0 0 0 0.7854</pose>
    </include>
    <include>
      <name>wall_gate_east</name>
      <uri>model://grey_wall</uri>
      <pose>32 4 0 0 0 -0.7854</pose>
    </include>

    <!-- Four lamp posts provide narrow pillar-like collision obstacles. -->
    <include>
      <name>lamp_post_nw</name>
      <uri>model://lamp_post</uri>
      <pose>-20 10 0 0 0 0</pose>
    </include>
    <include>
      <name>lamp_post_ne</name>
      <uri>model://lamp_post</uri>
      <pose>20 10 0 0 0 0</pose>
    </include>
    <include>
      <name>lamp_post_sw</name>
      <uri>model://lamp_post</uri>
      <pose>-20 -10 0 0 0 0</pose>
    </include>
    <include>
      <name>lamp_post_se</name>
      <uri>model://lamp_post</uri>
      <pose>20 -10 0 0 0 0</pose>
    </include>

    <include>
      <name>radio_tower</name>
      <uri>model://radio_tower</uri>
      <pose>-48 52 0 0 0 0</pose>
    </include>
    <include>
      <name>water_tower</name>
      <uri>model://water_tower</uri>
      <pose>48 -52 0 0 0 0</pose>
    </include>
    <include>
      <name>tower_crane</name>
      <uri>model://tower_crane</uri>
      <pose>55 -45 0 0 0 1.5708</pose>
    </include>

    <gui fullscreen="0">
      <camera name="city_overview">
        <pose>82 -82 72 0 0.52 2.35</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
