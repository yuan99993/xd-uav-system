<launch>
  <arg name="member_name" default="uav1"/>
  <arg name="config" default="$(find xd_uav_formation)/config/consensus.yaml"/>
  <arg name="reference_topic" default="control/reference/setpoint"/>
  <group ns="$(arg member_name)">
    <node pkg="xd_uav_formation" type="formation_follower.py"
          name="formation_consensus" output="screen" required="true">
      <rosparam command="load" file="$(find xd_uav_formation)/config/formation.yaml"/>
      <rosparam command="load" file="$(arg config)"/>
      <param name="reference_topic" value="$(arg reference_topic)"/>
    </node>
  </group>
</launch>
