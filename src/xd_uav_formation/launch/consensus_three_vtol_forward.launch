<?xml version="1.0"?>
<launch>
  <arg name="config" default="$(find xd_uav_formation)/config/consensus_three_vtol_forward.yaml"/>
  <arg name="start_manager" default="true"/>

  <include if="$(arg start_manager)"
           file="$(find xd_uav_formation)/launch/formation_manager.launch"/>

  <include file="$(find xd_uav_formation)/launch/consensus_member.launch">
    <arg name="member_name" value="uav1"/>
    <arg name="config" value="$(arg config)"/>
  </include>
  <include file="$(find xd_uav_formation)/launch/consensus_member.launch">
    <arg name="member_name" value="uav2"/>
    <arg name="config" value="$(arg config)"/>
  </include>
  <include file="$(find xd_uav_formation)/launch/consensus_member.launch">
    <arg name="member_name" value="uav3"/>
    <arg name="config" value="$(arg config)"/>
  </include>
</launch>
