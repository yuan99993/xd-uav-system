<?xml version="1.0"?>
<launch>
  <arg name="leader_name" default="uav1"/>
  <arg name="team_id" default="$(arg leader_name)"/>
  <arg name="follower_name" default="uav2"/>
  <arg name="forward" default="-4.0"/>
  <arg name="left" default="0.0"/>
  <arg name="up" default="0.0"/>
  <arg name="shape" default="manual"/>
  <arg name="follower_count" default="1"/>
  <arg name="slot_index" default="1"/>
  <arg name="spacing" default="20.0"/>
  <arg name="reference_topic" default="control/reference/setpoint"/>

  <group ns="$(arg follower_name)">
    <node pkg="xd_uav_formation" type="formation_follower.py"
          name="formation_follower" output="screen" required="true">
      <rosparam command="load" file="$(find xd_uav_formation)/config/formation.yaml"/>
      <rosparam param="offset" subst_value="true">[$(arg forward), $(arg left), $(arg up)]</rosparam>
      <param name="leader_name" value="$(arg leader_name)"/>
      <param name="team_id" value="$(arg team_id)"/>
      <param name="shape" value="$(arg shape)"/>
      <param name="follower_count" value="$(arg follower_count)" type="int"/>
      <param name="slot_index" value="$(arg slot_index)" type="int"/>
      <param name="spacing" value="$(arg spacing)" type="double"/>
      <param name="reference_topic" value="$(arg reference_topic)"/>
    </node>
  </group>
</launch>
