<?xml version="1.0"?>
<launch>
  <!-- Start only after all three VTOLs have completed transition forward. -->
  <arg name="leader_name" default="uav1"/>
  <arg name="team_id" default="three_vtol_forward_follow"/>
  <arg name="start_manager" default="true"/>

  <include if="$(arg start_manager)"
           file="$(find xd_uav_formation)/launch/formation_manager.launch"/>

  <include file="$(find xd_uav_formation)/launch/follower.launch">
    <arg name="leader_name" value="$(arg leader_name)"/>
    <arg name="team_id" value="$(arg team_id)"/>
    <arg name="follower_name" value="uav2"/>
    <arg name="forward" value="-90.0"/>
    <arg name="left" value="45.0"/>
  </include>
  <include file="$(find xd_uav_formation)/launch/follower.launch">
    <arg name="leader_name" value="$(arg leader_name)"/>
    <arg name="team_id" value="$(arg team_id)"/>
    <arg name="follower_name" value="uav3"/>
    <arg name="forward" value="-90.0"/>
    <arg name="left" value="-45.0"/>
  </include>
</launch>
