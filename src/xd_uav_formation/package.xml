  <version>0.1.0</version>
  <description>Leader-following and path-consensus formation references for UAV teams.</description>
  <maintainer email="kzy@example.com">kzy</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
