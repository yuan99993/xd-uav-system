<launch>
  <node pkg="xd_uav_formation" type="formation_manager_cpp"
        name="formation_manager" output="screen" required="true">
    <param name="config" value="$(find xd_uav_formation)/test/cpp_consensus.yaml"/>
    <param name="common_config" value="$(find xd_uav_formation)/config/common.yaml"/>
    <param name="spawn_members" value="true"/>
  </node>
  <test test-name="formation_cpp_consensus" pkg="xd_uav_formation"
        type="test_consensus_ros.py" time-limit="45"/>
</launch>
