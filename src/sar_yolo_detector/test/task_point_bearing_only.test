<launch>
  <node pkg="sar_yolo_detector" type="sar_task_point_generator"
        name="sar_task_point_bearing_test" output="screen" required="true">
    <param name="input_detections_topic" value="/sar_task_bearing_test/detections" />
    <param name="camera_info_topic" value="/sar_task_bearing_test/camera_info" />
    <param name="task_candidates_topic" value="/sar_task_bearing_test/candidates" />
    <param name="task_pose_topic" value="/sar_task_bearing_test/task_point" />
    <param name="localization_mode" value="bearing_only" />
    <param name="input_max_age_sec" value="5.0" />
    <param name="min_confirmations" value="1" />
    <param name="task_generation_enabled" value="true" />
    <param name="model_validated" value="true" />
    <rosparam param="task_class_ids">[0]</rosparam>
    <rosparam param="class_names">[person]</rosparam>
    <rosparam param="global_semantic_ids">[1]</rosparam>
    <rosparam param="class_anchor_y_fractions">[0.95]</rosparam>
  </node>
  <test test-name="task_point_bearing_only" pkg="sar_yolo_detector"
        type="test_task_point_bearing_only.py" time-limit="30" />
</launch>
