<launch>
  <node pkg="sar_yolo_detector" type="sar_vision_to_xd_bridge"
        name="vision_to_xd_bridge_test" output="screen" required="true">
    <param name="input_detections_topic" value="/vision_to_xd_test/input" />
    <param name="output_detections_topic" value="/vision_to_xd_test/output" />
    <param name="camera_info_topic" value="/vision_to_xd_test/camera_info" />
    <param name="image_source" value="eo" />
    <param name="sensor_id" value="down_camera" />
    <param name="detector_name" value="sar_yolo_test" />
    <param name="model_version" value="test_v1" />
  </node>
  <node pkg="sar_yolo_detector" type="sar_vision_to_xd_bridge"
        name="tracked_to_xd_bridge_test" output="screen" required="true">
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <rosparam param="class_names">[car, tank, drone]</rosparam>
    <param name="model_epoch" value="7" />
    <param name="input_detections_topic"
           value="/vision_to_xd_test/tracked_input" />
    <param name="input_type" value="tracked" />
    <param name="output_detections_topic"
           value="/vision_to_xd_test/tracked_output" />
    <param name="camera_info_topic"
           value="/vision_to_xd_test/camera_info" />
    <param name="image_source" value="eo" />
    <param name="sensor_id" value="fallback_camera" />
    <param name="detector_name" value="sar_yolo_smart_tracker" />
    <param name="model_version" value="fallback_model" />
  </node>
  <group ns="vision_to_xd_test">
    <node pkg="xd_uav_track" type="xd_uav_track_node" name="track" output="screen" required="true" clear_params="true">
      <rosparam command="load" file="$(find xd_uav_track)/config/track.yaml" />
      <param name="runtime/perception_only" value="true" />
      <param name="runtime/publish_control_reference" value="false" />
      <param name="interfaces/input/detections" value="/vision_to_xd_test/tracked_output" />
      <param name="tracker/input_timeout_sec" value="1.0" />
      <param name="tracker/selection/auto_select" value="false" />
      <param name="tracker/lifecycle/confirmation_hits" value="2" />
      <param name="tracker/classification/upstream_consensus" value="true" />
      <param name="tracker/association/high_confidence_threshold" value="0.25" />
      <rosparam param="tracker/association/compatible_class_ids">[0, 1]</rosparam>
    </node>
  </group>
  <test test-name="vision_to_xd_bridge" pkg="sar_yolo_detector"
        type="test_vision_to_xd_bridge.py" time-limit="30" />
</launch>
