#!/usr/bin/env bash
set -euo pipefail

export YOLO_AUTOINSTALL=false

package_dir="$(rospack find sar_yolo_detector)"
script_dir="$(cd "$(dirname "$0")" && pwd)"
node_script="$script_dir/multi_source_detection_node.py"
if [[ ! -f "$node_script" ]]; then
  node_script="$package_dir/scripts/multi_source_detection_node.py"
fi

# Keep the single- and multi-source launch paths on the same audited runtime.
# An explicit environment override wins; otherwise use the workspace-local GPU
# environment before falling back to the system interpreter.
python_executable="${SAR_YOLO_PYTHON:-${SAR_YOLO_SMART_PYTHON:-}}"
if [[ -z "$python_executable" ]]; then
  workspace_dir="$(cd "$package_dir/../.." 2>/dev/null && pwd || true)"
  if [[ -x "$workspace_dir/.venv-sar-gpu/bin/python" ]]; then
    python_executable="$workspace_dir/.venv-sar-gpu/bin/python"
  else
    python_executable="python3"
  fi
fi

ros_distro="${ROS_DISTRO:-noetic}"
ros_python_path="/opt/ros/$ros_distro/lib/python3/dist-packages"
export PYTHONPATH="${PYTHONPATH:+$PYTHONPATH:}$ros_python_path"
exec "$python_executable" "$node_script" "$@"
