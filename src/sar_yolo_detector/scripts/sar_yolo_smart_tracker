#!/usr/bin/env bash
set -euo pipefail

export YOLO_AUTOINSTALL=false

package_dir="$(rospack find sar_yolo_detector)"
script_dir="$(cd "$(dirname "$0")" && pwd)"
node_script="$script_dir/smart_tracker_node.py"
if [[ ! -f "$node_script" ]]; then
  node_script="$package_dir/scripts/smart_tracker_node.py"
fi

python_executable="${SAR_YOLO_SMART_PYTHON:-}"
if [[ -z "$python_executable" ]]; then
  workspace_dir="$(cd "$package_dir/../.." 2>/dev/null && pwd || true)"
  if [[ -x "$workspace_dir/.venv-sar-gpu/bin/python" ]]; then
    python_executable="$workspace_dir/.venv-sar-gpu/bin/python"
  else
    python_executable="python3"
  fi
fi

ros_distro="${ROS_DISTRO:-noetic}"
ros_python_path="/opt/ros/$ros_distro/lib/python3/dist-packages"
if [[ -n "${PYTHONPATH:-}" ]]; then
  export PYTHONPATH="$PYTHONPATH:$ros_python_path"
else
  export PYTHONPATH="$ros_python_path"
fi

echo "========== SAR YOLO DEBUG ==========" >&2
echo "python_executable=$python_executable" >&2
echo "SAR_YOLO_SMART_PYTHON=${SAR_YOLO_SMART_PYTHON:-EMPTY}" >&2
echo "LD_PRELOAD=${LD_PRELOAD:-EMPTY}" >&2
echo "PYTHONPATH=${PYTHONPATH:-EMPTY}" >&2

"$python_executable" - <<'PY'
import sys
print("[DEBUG] sys.executable =", sys.executable)

try:
    from ultralytics import YOLO
    print("[DEBUG] from ultralytics import YOLO = OK")
except Exception as e:
    print("[DEBUG] YOLO IMPORT ERROR =", repr(e))

try:
    from sar_yolo_detector.pixeagle.backends.ultralytics_backend import \
        ULTRALYTICS_AVAILABLE, ULTRALYTICS_IMPORT_ERROR
    print("[DEBUG] ULTRALYTICS_AVAILABLE =", ULTRALYTICS_AVAILABLE)
    print("[DEBUG] ULTRALYTICS_IMPORT_ERROR =", repr(ULTRALYTICS_IMPORT_ERROR))
except Exception as e:
    print("[DEBUG] BACKEND IMPORT ERROR =", repr(e))
PY

echo "====================================" >&2


exec "$python_executable" "$node_script" "$@"
