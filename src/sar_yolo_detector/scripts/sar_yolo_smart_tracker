#!/usr/bin/env bash
set -euo pipefail

export YOLO_AUTOINSTALL=false

package_dir="$(rospack find sar_yolo_detector)"
script_dir="$(cd "$(dirname "$0")" && pwd)"
node_script="$script_dir/smart_tracker_node.py"
if [[ ! -f "$node_script" ]]; then
  node_script="$package_dir/scripts/smart_tracker_node.py"
fi

python_executable="${SAR_YOLO_SMART_PYTHON:-}"
workspace_dir="$(cd "$package_dir/../.." 2>/dev/null && pwd || true)"
if [[ -z "$python_executable" ]]; then
  packaged_runtime="${SAR_DFINE_ENV:-${XDG_DATA_HOME:-$HOME/.local/share}/sar_yolo_detector/dfine-v3}"
  if [[ -x "$packaged_runtime/bin/python" ]]; then
    python_executable="$packaged_runtime/bin/python"
  elif [[ -x "$workspace_dir/.venv-dfine/bin/python" ]]; then
    python_executable="$workspace_dir/.venv-dfine/bin/python"
  elif [[ -x "$workspace_dir/.venv-fusion/bin/python" ]]; then
    # The isolated PT experiment needs CUDA and actual contrib KCF/CSRT.
    # An explicit interpreter remains the highest-priority deployment choice.
    python_executable="$workspace_dir/.venv-fusion/bin/python"
  elif [[ -x "$workspace_dir/.venv-sar-gpu/bin/python" ]]; then
    python_executable="$workspace_dir/.venv-sar-gpu/bin/python"
  else
    python_executable="python3"
  fi
fi

# D-FINE's interpreter currently has OpenCV without KCF/CSRT.  The approved
# fusion environment supplies contrib OpenCV for the preserved manual modes.
fusion_site="$workspace_dir/.venv-fusion/lib/python3.10/site-packages"
if [[ "$python_executable" == "$workspace_dir/.venv-dfine/bin/python" && -d "$fusion_site" ]]; then
  export PYTHONPATH="$fusion_site${PYTHONPATH:+:$PYTHONPATH}"
fi

ros_distro="${ROS_DISTRO:-noetic}"
ros_python_path="/opt/ros/$ros_distro/lib/python3/dist-packages"
if [[ -n "${PYTHONPATH:-}" ]]; then
  export PYTHONPATH="$PYTHONPATH:$ros_python_path"
else
  export PYTHONPATH="$ros_python_path"
fi

exec "$python_executable" "$node_script" "$@"
