<?xml version="1.0"?>
<package format="2">
  <name>sar_yolo_detector</name>
  <version>0.4.0</version>
  <description>
    PixEagle SmartTracker Fusion launch, shared model inference service, and XD
    detection bridge, with ROS message and service compatibility interfaces.
  </description>

  <maintainer email="maintainers@example.com">SAR Perception Team</maintainer>
  <license>BSD-3-Clause</license>
  <license>Apache-2.0</license>
  <license>AGPL-3.0-only</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>cv_bridge</depend>
  <depend>diagnostic_updater</depend>
  <depend>geometry_msgs</depend>
  <depend>image_geometry</depend>
  <depend>image_transport</depend>
  <depend>roscpp</depend>
  <depend>roslib</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>vision_msgs</depend>
  <depend>xd_uav_track</depend>

  <build_depend>message_generation</build_depend>
  <build_depend>libssl-dev</build_depend>
  <build_depend>libyaml-cpp-dev</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>libssl-dev</exec_depend>
  <exec_depend>libyaml-cpp-dev</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-nose</test_depend>
  <test_depend>rostest</test_depend>

  <export/>
</package>
