<?xml version="1.0"?>
<package format="2">
  <name>sar_yolo_detector</name>
  <version>0.4.0</version>
  <description>
    Scout-side PixEagle SmartTracker and search-and-rescue perception frontend.
    Stable tracked detections are localized into planner-facing task candidates;
    role-separated gateways connect scout perception and worker executors without
    depending on Pod, Follower, MRS, PX4, or other flight-control packages.
  </description>

  <maintainer email="maintainers@example.com">SAR Perception Team</maintainer>
  <license>BSD-3-Clause</license>
  <license>Apache-2.0</license>
  <license>AGPL-3.0-only</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>cv_bridge</depend>
  <depend>diagnostic_updater</depend>
  <depend>geometry_msgs</depend>
  <depend>image_geometry</depend>
  <depend>image_transport</depend>
  <depend>libssl-dev</depend>
  <depend>libsqlite3-dev</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>vision_msgs</depend>
  <depend>xd_uav_track</depend>

  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>

  <test_depend>gtest</test_depend>
  <test_depend>python3-nose</test_depend>
  <test_depend>rostest</test_depend>

  <export/>
</package>
