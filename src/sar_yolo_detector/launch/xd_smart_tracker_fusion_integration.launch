<launch>
  <!-- Isolated PixEagle/PT fusion entry, keeping the latest smart/selection topics. -->
  <!-- Real Ultralytics .pt inference for the XD detection/localization stack.
       This replaces the synthetic red-box detector but leaves xd_uav_detect
       independently configured and running. -->
  <arg name="UAV_NAME" default="$(optenv UAV_NAME uav1)" />
  <!-- Unique suffix for a second (for example gimbal) camera instance. -->
  <arg name="instance_name" default="smart" /> 
  <arg name="tracking_mode" default="" />
  <arg name="fusion_config" default="$(find sar_yolo_detector)/config/fusion_tracker.yaml" />
  <!-- 不要改这个instancename -->
  <arg name="config"
       default="$(find sar_yolo_detector)/config/smart_tracker.yaml" />
  <arg name="vehicle_config"
       default="$(find sar_yolo_detector)/config/smart_tracker_xd_vehicle.yaml" />
  <arg name="model_path"
       default="$(find sar_yolo_detector)/models/xd_vehicle_train7/xd_vehicle_train7.pt" />
  <arg name="model_sha256"
       default="8f2506e1fd9585eab0d23203f504ff0036d580327e55ef15d23bd9e46fd34b54" />
  <arg name="python_executable" default="" />
  <arg name="use_gpu" default="true" />
  <!-- One elected process per model hash owns the GPU model. Every UAV
       tracker remains independent and calls that process for detections. -->
  <arg name="shared_inference" default="true" />
  <!-- Use the provided static TensorRT engine directly at startup. Set to 2
       only when the cached dynamic-batch engine has already been built. -->
  <arg name="maximum_batch_size" default="1" />
  <!-- Drop frames that have already waited too long, keeping image updates fresh. -->
  <arg name="inference_max_fps" default="7.0" />
  <arg name="maximum_capture_age_sec" default="0.5" />
  <arg name="input_image_topic" default="down_camera/image_raw" />
  <arg name="camera_info_topic" default="down_camera/camera_info" />
  <arg name="camera_motion_fixed_frame" default="world" />
  <arg name="image_width" default="1280" />
  <arg name="image_height" default="720" />
  <arg name="tracked_detections_topic"
       default="sar_yolo_detector/$(arg instance_name)/tracked_detections" />
  <arg name="fusion_detections_topic" default="$(arg tracked_detections_topic)/fusion" />
  <arg name="fusion_observations_topic" default="$(arg tracked_detections_topic)/observations" />
  <arg name="selected_detections_topic"
       default="sar_yolo_detector/$(arg instance_name)/selected_tracked_detections" />
  <arg name="select_pixel_topic"
       default="sar_yolo_detector/$(arg instance_name)/select_pixel" />
  <arg name="auto_select_service"
       default="sar_yolo_detector/$(arg instance_name)/auto_select" />
  <arg name="auto_select_status_topic"
       default="sar_yolo_detector/$(arg instance_name)/auto_select_status" />
  <!-- Set gimbal_control.py ~detection_topic to this topic. SmartTracker
       selection can be started by a pixel click or the SetBool auto-select
       service; FeatureTracker publishes its valid ROI box directly here. -->
  <arg name="gimbal_detection_topic" default="$(arg selected_detections_topic)" />
  <arg name="output_detections_topic"
       default="track/selected_detections" />
  <!-- By default, bridge the UI's one selected box to the track controller.
       The optional detect bridge mirrors this input; change both bridge args
       only when intentionally forwarding all fusion observations. -->
  <arg name="bridge_input_topic" default="$(arg selected_detections_topic)" />
  <arg name="bridge_input_type" default="tracked" />
  <!-- Optionally route the same selected box through a second bridge into
       xd_uav_detect, while preserving the selected-box track-controller path. -->
  <arg name="detect_bridge_enabled" default="false" />
  <arg name="detect_output_detections_topic"
       default="detect/input/detections_2d" />
  <arg name="publish_annotated_image" default="true" />
  <arg name="image_source" default="fixed_rgb" />
  <arg name="sensor_id" default="fixed_camera" />

  <group if="$(arg shared_inference)">
    <node pkg="sar_yolo_detector" type="sar_yolo_shared_model_server"
          name="sar_yolo_shared_model_$(arg UAV_NAME)_$(arg instance_name)"
          output="screen">
      <env name="SAR_YOLO_SMART_PYTHON" value="$(arg python_executable)" />
      <param name="config" value="$(arg config)" />
      <param name="overlay_config" value="$(arg vehicle_config)" />
      <param name="model_path" value="$(arg model_path)" />
      <param name="model_sha256" value="$(arg model_sha256)" />
      <param name="use_gpu" value="$(arg use_gpu)" />
      <param name="fallback_to_cpu" value="false" />
      <param name="maximum_batch_size" value="$(arg maximum_batch_size)" />
      <param name="maximum_capture_age_sec" value="$(arg maximum_capture_age_sec)" />
    </node>
  </group>

  <group ns="$(arg UAV_NAME)">
    <include file="$(find sar_yolo_detector)/launch/smart_tracker_fusion.launch">
      <arg name="tracking_mode" value="$(arg tracking_mode)" />
      <arg name="fusion_config" value="$(arg fusion_config)" />
      <arg name="node_name" value="sar_yolo_smart_tracker_$(arg instance_name)" />
      <arg name="config" value="$(arg config)" />
      <arg name="overlay_config" value="$(arg vehicle_config)" />
      <arg name="input_image_topic" value="$(arg input_image_topic)" />
      <arg name="camera_info_topic" value="$(arg camera_info_topic)" />
      <arg name="camera_motion_fixed_frame" value="$(arg camera_motion_fixed_frame)" />
      <arg name="tracked_detections_topic"
           value="$(arg tracked_detections_topic)" />
      <arg name="fusion_detections_topic" value="$(arg fusion_detections_topic)" />
      <arg name="fusion_observations_topic" value="$(arg fusion_observations_topic)" />
      <arg name="selected_detections_topic"
           value="$(arg selected_detections_topic)" />
      <arg name="select_pixel_topic" value="$(arg select_pixel_topic)" />
      <arg name="auto_select_service" value="$(arg auto_select_service)" />
      <arg name="auto_select_status_topic" value="$(arg auto_select_status_topic)" />
      <arg name="state_topic" value="sar_yolo_detector/$(arg instance_name)/state" />
      <arg name="annotated_image_topic"
           value="sar_yolo_detector/$(arg instance_name)/annotated" />
      <arg name="model_path" value="$(arg model_path)" />
      <arg name="model_sha256" value="$(arg model_sha256)" />
      <arg name="use_gpu" value="$(arg use_gpu)" />
      <!-- Fail visibly instead of silently falling back to slow CPU inference. -->
      <arg name="fallback_to_cpu" value="false" />
      <arg name="python_executable" value="$(arg python_executable)" />
      <arg name="publish_annotated_image"
           value="$(arg publish_annotated_image)" />
      <arg name="shared_inference" value="$(arg shared_inference)" />
      <arg name="inference_max_fps" value="$(arg inference_max_fps)" />
      <arg name="maximum_capture_age_sec" value="$(arg maximum_capture_age_sec)" />
      <arg name="uav_id" value="$(arg UAV_NAME)" />
      <arg name="sensor_id" value="$(arg sensor_id)" />
      <arg name="profile" value="xd_vehicle_car_ar_car_tank" />
      <arg name="model_version" value="xd_vehicle_train7_best" />
    </include>
  </group>

  <!-- gimbal_control.py is intentionally not launched here. If it is started
       separately in this UAV namespace, it reads the single-target stream. -->
  <group ns="$(arg UAV_NAME)">
    <param name="gimbal_visual_servo/detection_input" value="tracked" />
    <param name="gimbal_visual_servo/detection_topic"
           value="$(arg gimbal_detection_topic)" />
  </group>

  <include file="$(find sar_yolo_detector)/archive/launch/xd_detection_bridge.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)" />
    <arg name="node_name" value="vision_to_xd_bridge_$(arg instance_name)" />
    <arg name="input_detections_topic"
         value="$(arg bridge_input_topic)" />
    <arg name="input_type" value="$(arg bridge_input_type)" />
    <arg name="output_detections_topic"
         value="$(arg output_detections_topic)" />
    <arg name="camera_info_topic" value="$(arg camera_info_topic)" />
    <arg name="image_width" value="$(arg image_width)" />
    <arg name="image_height" value="$(arg image_height)" />
    <arg name="image_source" value="$(arg image_source)" />
    <arg name="sensor_id" value="$(arg sensor_id)" />
    <arg name="detector_name" value="sar_yolo_smart_tracker" />
    <arg name="model_version" value="xd_vehicle_train7_best" />
  </include>

  <group if="$(arg detect_bridge_enabled)">
    <include file="$(find sar_yolo_detector)/archive/launch/xd_detection_bridge.launch">
      <arg name="UAV_NAME" value="$(arg UAV_NAME)" />
      <arg name="node_name" value="vision_to_xd_detect_bridge_$(arg instance_name)" />
      <arg name="input_detections_topic" value="$(arg bridge_input_topic)" />
      <arg name="input_type" value="$(arg bridge_input_type)" />
      <arg name="output_detections_topic"
           value="$(arg detect_output_detections_topic)" />
      <arg name="camera_info_topic" value="$(arg camera_info_topic)" />
      <arg name="image_width" value="$(arg image_width)" />
      <arg name="image_height" value="$(arg image_height)" />
      <arg name="image_source" value="$(arg image_source)" />
      <arg name="sensor_id" value="$(arg sensor_id)" />
      <arg name="detector_name" value="sar_yolo_smart_tracker" />
      <arg name="model_version" value="xd_vehicle_train7_best" />
    </include>
  </group>
</launch>
