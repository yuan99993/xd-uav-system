<launch>
  <!-- One immutable YOLO runtime feeds two independent DetectionArray topics. -->
  <arg name="UAV_NAME" default="$(optenv UAV_NAME uav1)" />
  <arg name="config" default="$(find sar_yolo_detector)/config/xd_vehicle_detection.yaml" />
  <arg name="overlay_config" default="" />
  <arg name="model_path" default="$(find sar_yolo_detector)/models/xd_vehicle_train7/xd_vehicle_train7.pt" />
  <arg name="model_sha256" default="8f2506e1fd9585eab0d23203f504ff0036d580327e55ef15d23bd9e46fd34b54" />
  <arg name="model_version" default="xd_vehicle_train7_best" />
  <!-- TensorRT FP16 is the default. A matching explicit engine is reused;
       otherwise a .pt source is exported once into the fingerprinted cache. -->
  <arg name="inference_backend" default="tensorrt_fp16" />
  <arg name="engine_path" default="$(find sar_yolo_detector)/models/xd_vehicle_train7/xd_vehicle_train7.engine" />
  <arg name="engine_sha256" default="88ed19419dcefdf64f6c90f31aa7961ef906c31d3581633afba69fa586bc850f" />
  <arg name="engine_source_model_sha256" default="8f2506e1fd9585eab0d23203f504ff0036d580327e55ef15d23bd9e46fd34b54" />
  <arg name="auto_export_engine" default="true" />
  <arg name="engine_cache_dir" default="~/.cache/sar_yolo_detector/tensorrt" />
  <arg name="engine_image_size" default="640" />
  <arg name="engine_workspace_gib" default="0.5" />
  <arg name="engine_builder_optimization_level" default="1" />
  <arg name="use_gpu" default="true" />
  <arg name="pause_without_subscribers" default="true" />
  <arg name="batch_wait_ms" default="4.0" />
  <!-- Static TensorRT engines may only accept batch=1. Keep this configurable
       so dynamic-batch engines can opt back into shared multi-frame batches. -->
  <arg name="maximum_batch_size" default="1" />
  <arg name="startup_warmup_frames" default="1" />
  <arg name="tracking_tracks_topic" default="track/tracks_by_source" />
  <arg name="priority_source" default="" />
  <arg name="discovery_max_fps" default="4.0" />
  <arg name="priority_max_fps" default="4.0" />
  <arg name="standby_max_fps" default="4.0" />
  <arg name="roi_inference_image_size" default="640" />
  <arg name="pixel_assist_enabled" default="true" />
  <arg name="pixel_assist_hint_timeout_sec" default="2.2" />
  <arg name="pixel_assist_confidence" default="0.45" />
  <arg name="fixed_image_topic" default="fixed_camera/image_raw" />
  <arg name="gimbal_image_topic" default="gimbal_camera/image_raw" />
  <arg name="fixed_output_topic" default="detect/input/fixed/detections_2d" />
  <arg name="gimbal_output_topic" default="detect/input/gimbal/detections_2d" />
  <arg name="fixed_image_source" default="fixed_rgb" />
  <arg name="gimbal_image_source" default="gimbal_rgb" />
  <arg name="fixed_sensor_id" default="fixed_camera" />
  <arg name="gimbal_sensor_id" default="gimbal_camera" />
  <arg name="reid_enabled" default="true" />
  <arg name="reid_config" default="$(find xd_uav_track)/config/reid.yaml" />
  <arg name="fixed_reid_profile" default="xd_vehicle_train7" />
  <arg name="fixed_detection_area" default="[0.0, 0.0, 1.0, 1.0]" />
  <arg name="gimbal_reid_profile" default="xd_vehicle_train7" />

  <group ns="$(arg UAV_NAME)">
    <node pkg="sar_yolo_detector" type="sar_yolo_multi_source_detection"
          name="sar_yolo_multi_source_detection" output="screen" required="true">
      <env name="SAR_YOLO_PYTHON" value="$(optenv SAR_YOLO_PYTHON)" />
      <rosparam command="load" file="$(arg config)" />
      <rosparam if="$(eval arg('overlay_config') != '')" command="load"
                file="$(arg overlay_config)" />
      <rosparam if="$(arg reid_enabled)" command="load" file="$(arg reid_config)" />
      <param name="model_path" value="$(arg model_path)" />
      <param name="inference_backend" value="$(arg inference_backend)" />
      <param name="engine_path" value="$(arg engine_path)" />
      <param name="engine_sha256" value="$(arg engine_sha256)" />
      <param name="engine_source_model_sha256" value="$(arg engine_source_model_sha256)" />
      <param name="auto_export_engine" value="$(arg auto_export_engine)" />
      <param name="engine_cache_dir" value="$(arg engine_cache_dir)" />
      <param name="engine_image_size" value="$(arg engine_image_size)" />
      <param name="engine_workspace_gib" value="$(arg engine_workspace_gib)" />
      <param name="engine_builder_optimization_level" value="$(arg engine_builder_optimization_level)" />
      <param name="use_gpu" value="$(arg use_gpu)" />
      <param name="fallback_to_cpu" value="false" />
      <param name="pause_without_subscribers" value="$(arg pause_without_subscribers)" />
      <param name="batch_wait_ms" value="$(arg batch_wait_ms)" />
      <param name="maximum_batch_size" value="$(arg maximum_batch_size)" />
      <param name="startup_warmup_frames" value="$(arg startup_warmup_frames)" />
      <param name="tracking_tracks_topic" value="$(arg tracking_tracks_topic)" />
      <param name="priority_source" value="$(arg priority_source)" />
      <param name="discovery_max_fps" value="$(arg discovery_max_fps)" />
      <param name="priority_max_fps" value="$(arg priority_max_fps)" />
      <param name="standby_max_fps" value="$(arg standby_max_fps)" />
      <param name="roi_inference_image_size" value="$(arg roi_inference_image_size)" />
      <param name="pixel_assist_enabled" value="$(arg pixel_assist_enabled)" />
      <param name="pixel_assist_hint_timeout_sec" value="$(arg pixel_assist_hint_timeout_sec)" />
      <param name="pixel_assist_confidence" value="$(arg pixel_assist_confidence)" />
      <param name="SmartTracker/SMART_TRACKER_GPU_MODEL_PATH" value="$(arg model_path)" />
      <param name="SmartTracker/SMART_TRACKER_CPU_MODEL_PATH" value="$(arg model_path)" />
      <param name="SmartTracker/SMART_TRACKER_MODEL_SHA256" value="$(arg model_sha256)" />
      <rosparam param="sources" subst_value="true">
        - name: fixed
          input_image_topic: $(arg fixed_image_topic)
          xd_detections_topic: $(arg fixed_output_topic)
          image_source: $(arg fixed_image_source)
          sensor_id: $(arg fixed_sensor_id)
          detector_name: sar_yolo_detector
          model_version: $(arg model_version)
          reid_enabled: $(arg reid_enabled)
          reid_model_profile: $(arg fixed_reid_profile)
          detection_area: $(arg fixed_detection_area)
          roi_recovery_enabled: true
          roi_padding_ratio: 1.0
          roi_target_short_side: 56
          roi_min_padding_ratio: 0.35
          roi_max_padding_ratio: 1.0
          roi_min_short_side: 24
        - name: gimbal
          input_image_topic: $(arg gimbal_image_topic)
          xd_detections_topic: $(arg gimbal_output_topic)
          image_source: $(arg gimbal_image_source)
          sensor_id: $(arg gimbal_sensor_id)
          detector_name: sar_yolo_detector
          model_version: $(arg model_version)
          reid_enabled: $(arg reid_enabled)
          reid_model_profile: $(arg gimbal_reid_profile)
          roi_recovery_enabled: false
      </rosparam>
    </node>
  </group>
</launch>
