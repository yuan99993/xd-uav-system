<launch>
  <!-- Message-only adapter. Keep xd_uav_detect running with its existing
       launch/config and place this launch in the same UAV namespace. -->
  <arg name="UAV_NAME" default="$(optenv UAV_NAME uav1)" />
  <arg name="node_name" default="vision_to_xd_bridge" />
  <arg name="input_detections_topic"
       default="sar_yolo_detector/detections" />
  <arg name="input_type" default="vision" />
  <arg name="output_detections_topic"
       default="detect/input/detections_2d" />
  <arg name="camera_info_topic" default="down_camera/camera_info" />
  <arg name="image_source" default="eo" />
  <arg name="sensor_id" default="down_camera" />
  <arg name="detector_name" default="sar_yolo_detector" />
  <arg name="model_version" default="unknown" />

  <group ns="$(arg UAV_NAME)">
    <node pkg="sar_yolo_detector" type="sar_vision_to_xd_bridge"
          name="$(arg node_name)" output="screen" required="true">
      <param name="input_detections_topic"
             value="$(arg input_detections_topic)" />
      <param name="input_type" value="$(arg input_type)" />
      <param name="output_detections_topic"
             value="$(arg output_detections_topic)" />
      <param name="camera_info_topic" value="$(arg camera_info_topic)" />
      <param name="image_source" value="$(arg image_source)" />
      <param name="sensor_id" value="$(arg sensor_id)" />
      <param name="detector_name" value="$(arg detector_name)" />
      <param name="model_version" value="$(arg model_version)" />
    </node>
  </group>
</launch>
