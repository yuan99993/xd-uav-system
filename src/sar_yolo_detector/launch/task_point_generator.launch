<launch>
  <arg name="config" default="$(find sar_yolo_detector)/config/task_point_generator.yaml" />
  <arg name="input_detections_topic" default="sar_yolo_detector/detections" />
  <arg name="use_tracked_detections" default="false" />
  <arg name="tracked_detections_topic" default="sar_yolo_detector/tracked_detections" />
  <arg name="camera_info_topic" default="camera/camera_info" />
  <arg name="task_candidates_topic" default="sar_yolo_detector/task_candidates" />
  <arg name="task_pose_topic" default="sar_yolo_detector/task_point" />
  <arg name="task_frame" default="map" />
  <arg name="localization_mode" default="bearing_only" />
  <arg name="ground_plane_z" default="0.0" />
  <arg name="terrain_grid_topic" default="terrain/elevation_grid" />
  <arg name="mission_id" default="mission_unset" />
  <arg name="uav_id" default="uav_unset" />
  <arg name="session_uuid" default="$(anon perception_session)" />
  <arg name="calibration_version" default="unversioned" />
  <arg name="task_generation_enabled" default="false" />
  <arg name="model_validated" default="false" />
  <arg name="allow_experimental_model" default="false" />
  <arg name="model_sha256" default="" />
  <arg name="coordinate_contract"
       default="$(eval 'CAMERA_RAY' if arg('localization_mode') == 'bearing_only' else 'LOCAL_ENU:' + arg('task_frame'))" />

  <node pkg="sar_yolo_detector" type="sar_task_point_generator"
        name="sar_task_point_generator" output="screen">
    <rosparam command="load" file="$(arg config)" />
    <param name="input_detections_topic" value="$(arg input_detections_topic)" />
    <param name="use_tracked_detections" value="$(arg use_tracked_detections)" />
    <param name="tracked_detections_topic" value="$(arg tracked_detections_topic)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="task_candidates_topic" value="$(arg task_candidates_topic)" />
    <param name="task_pose_topic" value="$(arg task_pose_topic)" />
    <param name="task_frame" value="$(arg task_frame)" />
    <param name="localization_mode" value="$(arg localization_mode)" />
    <param name="ground_plane_z" value="$(arg ground_plane_z)" />
    <param name="terrain_grid_topic" value="$(arg terrain_grid_topic)" />
    <param name="mission_id" value="$(arg mission_id)" />
    <param name="uav_id" value="$(arg uav_id)" />
    <param name="session_uuid" value="$(arg session_uuid)" />
    <param name="calibration_version" value="$(arg calibration_version)" />
    <param name="task_generation_enabled" value="$(arg task_generation_enabled)" />
    <param name="model_validated" value="$(arg model_validated)" />
    <param name="allow_experimental_model" value="$(arg allow_experimental_model)" />
    <param if="$(eval arg('model_sha256') != '')"
           name="model_sha256" value="$(arg model_sha256)" />
    <param name="coordinate_contract" value="$(arg coordinate_contract)" />
  </node>
</launch>
