<launch>
  <!-- Only input RGB/K/camera TF are replayed; detector/tracker outputs are recomputed. -->
  <arg name="bag" />
  <arg name="selection_validation" default="" />
  <arg name="UAV_NAME" default="rgb_replay" />
  <arg name="rate" default="1.0" />
  <arg name="output" default="$(env HOME)/.ros/sar_rgb_replay/$(anon run)" />
  <arg name="web_port" default="8788" />
  <arg name="python_executable" default="" />
  <arg name="world_frame" default="rgb_replay_world" />
  <param name="/use_sim_time" value="false" />
  <include file="$(find sar_yolo_detector)/launch/ue_dfine_v3_legacy_four_modes.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)" />
    <arg name="input_image_topic" value="/$(arg UAV_NAME)/fixed_camera/image_raw" />
    <arg name="camera_info_topic" value="/$(arg UAV_NAME)/fixed_camera/camera_info" />
    <arg name="camera_motion_fixed_frame" value="$(arg world_frame)" />
    <arg name="python_executable" value="$(arg python_executable)" />
    <arg name="web_port" value="$(arg web_port)" />
  </include>
  <arg name="selection_validation_args" default="$(eval &quot;--selection-validation '&quot; + arg('selection_validation') + &quot;'&quot; if arg('selection_validation') else '')" />
  <node pkg="sar_yolo_detector" type="replay_ue_rgb.py"  name="rgb_recording_input" output="screen" required="true"
        args="--bag '$(arg bag)' $(arg selection_validation_args) --namespace $(arg UAV_NAME) --rate $(arg rate) --world-frame $(arg world_frame) --wait-for-node /$(arg UAV_NAME)/sar_yolo_smart_tracker_dfine_v3 --summary '$(arg output)/replay_summary.json' --mapping '$(arg output)/capture_mapping.jsonl'" />
</launch>
