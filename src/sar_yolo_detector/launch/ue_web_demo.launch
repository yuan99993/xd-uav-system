<launch>
  <arg name="image_width" default="640" /><arg name="image_height" default="384" /><arg name="platform_config" default="$(find sar_yolo_detector)/config/platform/eo_ir_upgrade.yaml" /><arg name="output" default="$(env HOME)/.ros/sar_ue/$(anon web_demo)" /><arg name="python_executable" /><arg name="ue_project" /><include file="$(find sar_yolo_detector)/web/demo/demo_ue_civil_moving_targets.launch">
    <arg name="image_width" value="$(arg image_width)" /><arg name="image_height" value="$(arg image_height)" /><arg name="platform_config" value="$(arg platform_config)" /><arg name="ue_project" value="$(arg ue_project)" /><arg name="pose_source" value="kinematic" /><arg name="capture_fps" value="25" /><arg name="seconds" value="7200" /><arg name="output" value="$(arg output)" /><arg name="python_executable" value="$(arg python_executable)" /><arg name="model_path" value="$(find sar_yolo_detector)/web/demo/model/manifest.json" /><arg name="model_sha256" value="f288b8d9c2385b6f75926651ab8d85dce1b0393f434ba87b830556f81d10fbe8" /><arg name="model_version" value="dfine_s_v3_domain_head15_roi" /><arg name="scene" value="$(find sar_yolo_detector)/web/demo/light_grass_scene.json" /></include></launch>
