<launch>
  <!-- Compatibility entry point for xd-uav-system. MAVROS, PX4, and TF are started elsewhere. -->
  <arg name="uav_name" default="$(optenv UAV_NAME uav1)" />
  <arg name="world_frame" default="world" />
  <arg name="planning_input_frame" default="$(arg world_frame)" />
  <arg name="location" default="davosdorf" />
  <arg name="planner_config" default="$(find terrain_navigation_ros)/config/planner.yaml" />
  <arg name="path_output_topic" default="planned_path" />

  <include file="$(find terrain_navigation_ros)/launch/planner_only.launch">
    <arg name="uav_name" value="$(arg uav_name)" />
    <arg name="world_frame" value="$(arg world_frame)" />
    <arg name="planning_input_frame" value="$(arg planning_input_frame)" />
    <arg name="location" value="$(arg location)" />
    <arg name="planner_config" value="$(arg planner_config)" />
    <arg name="path_output_topic" value="$(arg path_output_topic)" />
  </include>
</launch>
