<launch>
  <arg name="UAV_NAME" default="$(optenv UAV_NAME uav1)"/>
  <arg name="config" default="$(find xd_uav_detect)/config/lidar_camera.yaml"/>
  <arg name="body_frame" default="$(arg UAV_NAME)/base_link"/>
  <arg name="world_frame" default="$(arg UAV_NAME)/local_origin"/>
  <arg name="detections_compat" default=""/>
  <!-- Optional per-vehicle topic overrides. Empty values keep the YAML values. -->
  <arg name="image_topic" default=""/>
  <arg name="camera_info_topic" default=""/>
  <arg name="point_cloud_topic" default=""/>
  <arg name="laser_range_topic" default=""/>
  <arg name="geodetic_enabled" default="false"/>
  <arg name="geodetic_origin_topic"
       default="mavros/global_position/gp_origin"/>
  <arg name="geodetic_input_topic" default="detect/detections_world"/>
  <arg name="geodetic_output_topic"
       default="detect/detections_geodetic"/>
  <arg name="geodetic_local_origin_frame" default="$(arg world_frame)"/>
  <arg name="geodetic_tf_timeout_sec" default="0.1"/>
  <arg name="geodetic_use_static_origin" default="false"/>
  <arg name="geodetic_static_latitude" default="nan"/>
  <arg name="geodetic_static_longitude" default="nan"/>
  <arg name="geodetic_static_altitude" default="nan"/>

  <group ns="$(arg UAV_NAME)">
    <node pkg="xd_uav_detect"
          type="xd_uav_detect_node"
          name="detect"
          output="screen"
          clear_params="true">
      <rosparam command="load" file="$(arg config)"/>
      <param name="frames/body" value="$(arg body_frame)"/>
      <param name="frames/world" value="$(arg world_frame)"/>
      <param name="interfaces/output/detections_compat" value="$(arg detections_compat)"/>
      <param if="$(eval arg('image_topic') != '')"
             name="interfaces/input/image" value="$(arg image_topic)"/>
      <param if="$(eval arg('camera_info_topic') != '')"
             name="interfaces/input/camera_info" value="$(arg camera_info_topic)"/>
      <param if="$(eval arg('point_cloud_topic') != '')"
             name="interfaces/input/point_cloud" value="$(arg point_cloud_topic)"/>
      <param if="$(eval arg('laser_range_topic') != '')"
             name="interfaces/input/laser_range" value="$(arg laser_range_topic)"/>
    </node>
    <node if="$(arg geodetic_enabled)"
          pkg="xd_uav_detect"
          type="world_detection_georeferencer_node"
          name="world_detection_georeferencer"
          output="screen"
          clear_params="true">
      <param name="input_topic" value="$(arg geodetic_input_topic)"/>
      <param name="output_topic" value="$(arg geodetic_output_topic)"/>
      <param name="origin_topic" value="$(arg geodetic_origin_topic)"/>
      <param name="local_origin_frame"
             value="$(arg geodetic_local_origin_frame)"/>
      <param name="tf_timeout_sec" value="$(arg geodetic_tf_timeout_sec)"/>
      <param name="use_static_origin"
             value="$(arg geodetic_use_static_origin)"/>
      <param name="static_origin/latitude"
             type="double" value="$(arg geodetic_static_latitude)"/>
      <param name="static_origin/longitude"
             type="double" value="$(arg geodetic_static_longitude)"/>
      <param name="static_origin/altitude"
             type="double" value="$(arg geodetic_static_altitude)"/>
    </node>
  </group>
</launch>
