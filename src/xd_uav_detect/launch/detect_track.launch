<launch>
  <arg name="UAV_NAME" default="$(optenv UAV_NAME uav1)"/>
  <arg name="uav_name" default="$(arg UAV_NAME)"/>
  <arg name="detect_config" default="$(find xd_uav_detect)/config/detect.yaml"/>
  <arg name="track_config" default="$(find xd_uav_track)/config/track.yaml"/>
  <arg name="image_topic" default="/$(arg uav_name)/camera/image_raw"/>
  <arg name="camera_info_topic"
       default="/$(arg uav_name)/camera/camera_info"/>
  <arg name="point_cloud_topic" default="/$(arg uav_name)/fastlio/points"/>
  <arg name="debug_image_topic"
       default="/$(arg uav_name)/detect/debug/image"/>
  <arg name="state_topic"
       default="/$(arg uav_name)/state_estimator/main/odom"/>
  <arg name="reference_topic"
       default="/$(arg uav_name)/control/reference/setpoint"/>
  <arg name="publish_control_reference" default="true"/>
  <arg name="tracker_enabled_at_startup" default="false"/>
  <arg name="follower_profile" default="mc_velocity_chase"/>

  <include file="$(find xd_uav_detect)/launch/detect.launch">
    <arg name="uav_name" value="$(arg uav_name)"/>
    <arg name="config" value="$(arg detect_config)"/>
    <arg name="image_topic" value="$(arg image_topic)"/>
    <arg name="camera_info_topic" value="$(arg camera_info_topic)"/>
    <arg name="point_cloud_topic" value="$(arg point_cloud_topic)"/>
    <arg name="debug_image_topic" value="$(arg debug_image_topic)"/>
  </include>

  <include file="$(find xd_uav_track)/launch/track.launch">
    <arg name="uav_name" value="$(arg uav_name)"/>
    <arg name="config" value="$(arg track_config)"/>
    <arg name="state_topic" value="$(arg state_topic)"/>
    <arg name="reference_topic" value="$(arg reference_topic)"/>
    <arg name="publish_control_reference"
         value="$(arg publish_control_reference)"/>
    <arg name="tracker_enabled_at_startup"
         value="$(arg tracker_enabled_at_startup)"/>
    <arg name="follower_profile" value="$(arg follower_profile)"/>
  </include>
</launch>
