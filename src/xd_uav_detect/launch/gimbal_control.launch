<launch>
  <arg name="UAV_NAME" default="$(optenv UAV_NAME uav1)"/>
  <arg name="config"
       default="$(find xd_uav_detect)/config/gimbal_control.yaml"/>
  <arg name="body_frame" default="$(arg UAV_NAME)/base_link"/>

  <group ns="$(arg UAV_NAME)">
    <node pkg="xd_uav_detect" type="gimbal_control_node"
          name="gimbal_control" output="screen" clear_params="true">
      <rosparam command="load" file="$(arg config)"/>
      <param name="state_frame" value="$(arg body_frame)"/>
    </node>
  </group>
</launch>
