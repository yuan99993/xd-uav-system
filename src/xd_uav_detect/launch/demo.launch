<launch>
  <!-- Public demonstration entrypoint: sensor | px4 | flight. -->
  <arg name="mode" default="sensor"/>
  <arg name="gui" default="true"/>
  <arg name="loop" default="true"/>
  <arg name="stage_duration" default="7.0"/>
  <arg name="run_demo_sequence" default="true"/>
  <arg name="auto_takeoff" default="true"/>
  <arg name="geodetic_enabled" default="false"/>
  <arg name="world_file"
       default="$(find xd_uav_detect)/worlds/gimbal_range_flight_demo.world"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="z" default="0.3"/>
  <arg name="yaw" default="0.0"/>
  <arg name="fcu_url"
       default="udp://:14540@localhost:14557"/>

  <env name="GAZEBO_MODEL_PATH"
       value="$(find xd_uav_detect)/models:$(find px4)/Tools/sitl_gazebo/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <group if="$(eval arg('mode') == 'sensor')">
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name"
           value="$(find xd_uav_detect)/worlds/gimbal_range_demo.world"/>
      <arg name="gui" value="$(arg gui)"/>
      <arg name="paused" value="false"/>
      <arg name="use_sim_time" value="true"/>
    </include>
    <node pkg="gazebo_ros" type="spawn_model"
          name="spawn_x500_gimbal_sensor_demo" output="screen"
          args="-sdf -file $(find xd_uav_detect)/models/x500_gimbal/sensor_demo.sdf -model x500_gimbal -x 0 -y 0 -z 1"/>
  </group>

  <group if="$(eval arg('mode') in ['px4', 'flight'])">
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
      <arg name="world_name" value="$(arg world_file)"/>
      <arg name="gui" value="$(arg gui)"/>
      <arg name="paused" value="false"/>
      <arg name="use_sim_time" value="true"/>
    </include>
    <include file="$(find xd_uav_control_manager)/launch/sitl/px4_sitl_vehicle.launch">
      <arg name="UAV_NAME" value="uav1"/>
      <!-- The payload SDF is a quad-X airframe; PX4 uses its standard Iris
           startup profile while Gazebo loads the repository payload model. -->
      <arg name="vehicle" value="iris"/>
      <arg name="sdf_source"
           value="$(find xd_uav_detect)/models/x500_gimbal/model.sdf"/>
      <arg name="sdf_environment_root" value="$(find xd_uav_detect)/models"/>
      <arg name="x" value="$(arg x)"/>
      <arg name="y" value="$(arg y)"/>
      <arg name="z" value="$(arg z)"/>
      <arg name="yaw" value="$(arg yaw)"/>
      <arg name="mavros_fcu_url" value="$(arg fcu_url)"/>
    </include>
  </group>

  <group if="$(eval arg('mode') == 'flight')">
    <include file="$(find xd_uav_control_manager)/launch/sitl/px4_sitl_multirotor_system.launch">
      <arg name="UAV_NAME" value="uav1"/>
      <arg name="controller_override_config"
           value="$(find xd_uav_detect)/config/demo/px4_x500_gimbal_sitl.yaml"/>
    </include>
    <group ns="uav1">
      <node if="$(arg auto_takeoff)" pkg="xd_uav_control_manager"
            type="auto_takeoff_when_ready.py" name="auto_takeoff_when_ready"
            output="screen">
        <param name="altitude" value="1.5"/>
      </node>
    </group>
  </group>

  <group if="$(eval arg('mode') in ['sensor', 'flight'])">
    <node pkg="tf2_ros" type="static_transform_publisher"
          name="gimbal_laser_to_optical"
          args="0 0 0 -1.57079632679 0 -1.57079632679 uav1/gimbal_laser uav1/gimbal_camera_optical"/>
    <include file="$(find xd_uav_detect)/launch/gimbal_control.launch">
      <arg name="UAV_NAME" value="uav1"/>
    </include>
    <include file="$(find xd_uav_detect)/launch/detect.launch">
      <arg name="UAV_NAME" value="uav1"/>
      <arg name="config"
           value="$(find xd_uav_detect)/config/gimbal_laser_range.yaml"/>
      <arg name="body_frame" value="uav1/base_link"/>
      <arg name="world_frame" value="map"/>
      <arg name="geodetic_enabled" value="$(arg geodetic_enabled)"/>
      <arg name="geodetic_local_origin_frame" value="map"/>
      <arg name="geodetic_origin_topic"
           value="mavros/global_position/gp_origin"/>
      <arg name="geodetic_use_static_origin"
           value="$(eval arg('mode') == 'sensor')"/>
      <!-- Static datum is the gimbal_range_demo.world spherical_coordinates. -->
      <arg name="geodetic_static_latitude" value="47.397743"/>
      <arg name="geodetic_static_longitude" value="8.545594"/>
      <arg name="geodetic_static_altitude" value="0.0"/>
    </include>
    <param name="/uav1/detect/gimbal_range/maximum_time_difference_sec"
           value="0.15"/>
    <node if="$(arg run_demo_sequence)"
          pkg="xd_uav_detect" type="gimbal_range_demo.py"
          name="gimbal_range_demo" output="screen" required="true">
      <param name="model_name"
             value="$(eval 'uav1' if arg('mode') == 'flight' else 'x500_gimbal')"/>
      <param name="airborne_min_z"
             value="$(eval 0.8 if arg('mode') == 'flight' else 0.0)"/>
      <param name="ready_timeout"
             value="$(eval 90.0 if arg('mode') == 'flight' else 30.0)"/>
      <param name="loop" value="$(arg loop)"/>
      <param name="stage_duration" value="$(arg stage_duration)"/>
    </node>
  </group>
</launch>
