<?xml version="1.0"?>
<sdf version="1.6">
  <world name="gimbal_range_flight_demo">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>47.397743</latitude_deg>
      <longitude_deg>8.545594</longitude_deg>
      <elevation>0.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="flight_physics" default="1" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
      <magnetic_field>6.0e-06 2.3e-05 -4.2e-05</magnetic_field>
    </physics>

    <model name="red_target">
      <static>true</static>
      <pose>10 0 1.5 0 0 0</pose>
      <link name="target">
        <collision name="collision">
          <geometry><box><size>1 2 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 2 2</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
