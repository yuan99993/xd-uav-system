      <robotNamespace/>
    </plugin>
    <plugin name='magnetometer_plugin' filename='libgazebo_magnetometer_plugin.so'>
      <robotNamespace/>
      <pubRate>100</pubRate>
      <noiseDensity>0.0004</noiseDensity>
      <randomWalk>6.4e-06</randomWalk>
      <biasCorrelationTime>600</biasCorrelationTime>
      <magTopic>/mag</magTopic>
    </plugin>
    <plugin name='barometer_plugin' filename='libgazebo_barometer_plugin.so'>
      <robotNamespace/>
      <pubRate>50</pubRate>
      <baroTopic>/baro</baroTopic>
    </plugin>
    <plugin name='mavlink_interface' filename='libgazebo_mavlink_interface.so'>
      <robotNamespace></robotNamespace>
      <imuSubTopic>/imu</imuSubTopic>
      <magSubTopic>/mag</magSubTopic>
      <baroSubTopic>/baro</baroSubTopic>
      <mavlink_addr>INADDR_ANY</mavlink_addr>
      <mavlink_tcp_port>4560</mavlink_tcp_port>
      <mavlink_udp_port>14560</mavlink_udp_port>
      <serialEnabled>0</serialEnabled>
      <serialDevice>/dev/ttyACM0</serialDevice>
      <baudRate>921600</baudRate>
      <qgc_addr>INADDR_ANY</qgc_addr>
      <qgc_udp_port>14550</qgc_udp_port>
      <sdk_addr>INADDR_ANY</sdk_addr>
      <sdk_udp_port>14540</sdk_udp_port>
      <hil_mode>0</hil_mode>
      <hil_state_level>false</hil_state_level>
      <enable_lockstep>true</enable_lockstep>
      <use_tcp>true</use_tcp>
      <motorSpeedCommandPubTopic>/gazebo/command/motor_speed</motorSpeedCommandPubTopic>
      <control_channels>
        <channel name="rudder">
          <input_index>2</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>position_kinematic</joint_control_type>
          <joint_name>rudder_joint</joint_name>
        </channel>
        <channel name="rotor4">
          <input_index>4</input_index>
          <input_offset>0</input_offset>
          <input_scaling>3500</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>velocity</joint_control_type>
          <joint_name>rotor_puller_joint</joint_name>
        </channel>
        <channel name="left_elevon">
          <input_index>5</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>position_kinematic</joint_control_type>
          <joint_name>left_elevon_joint</joint_name>
        </channel>
        <channel name="right_elevon">
          <input_index>6</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>position_kinematic</joint_control_type>
          <joint_name>right_elevon_joint</joint_name>
        </channel>
        <channel name="elevator">
          <input_index>7</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>position_kinematic</joint_control_type>
          <joint_name>elevator_joint</joint_name>
        </channel>
        <channel name="left_flap">
          <input_index>3</input_index>
          <input_offset>0</input_offset>
          <input_scaling>-1</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>position_kinematic</joint_control_type>
          <joint_name>left_flap_joint</joint_name>
        </channel>
        <channel name="right_flap">
          <input_index>8</input_index>
          <input_offset>0</input_offset>
          <input_scaling>-1</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>position_kinematic</joint_control_type>
          <joint_name>right_flap_joint</joint_name>
        </channel>
      </control_channels>
    </plugin>
    <static>0</static>
    <plugin name='gazebo_imu_plugin' filename='libgazebo_imu_plugin.so'>
      <robotNamespace></robotNamespace>
      <linkName>plane/imu_link</linkName>
      <imuTopic>/imu</imuTopic>
      <gyroscopeNoiseDensity>0.0003394</gyroscopeNoiseDensity>
      <gyroscopeRandomWalk>3.8785e-05</gyroscopeRandomWalk>
      <gyroscopeBiasCorrelationTime>1000.0</gyroscopeBiasCorrelationTime>
      <gyroscopeTurnOnBiasSigma>0.0087</gyroscopeTurnOnBiasSigma>
      <accelerometerNoiseDensity>0.004</accelerometerNoiseDensity>
      <accelerometerRandomWalk>0.006</accelerometerRandomWalk>
      <accelerometerBiasCorrelationTime>300.0</accelerometerBiasCorrelationTime>
      <accelerometerTurnOnBiasSigma>0.196</accelerometerTurnOnBiasSigma>
    </plugin>
<!-- XD_UAV_DETECT_EO_GIMBAL_BEGIN -->
    <!-- +X is the shared camera/range boresight. -->
    <link name="gimbal_mount">
      <pose>0.0918 0.0015 -0.0159 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.02</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial>
      <visual name="mount_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://plane_gimbal/meshes/cgo3_mount_remeshed_v1.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="gimbal_mount_joint" type="fixed">
      <parent>base_link</parent><child>gimbal_mount</child>
    </joint>
    <link name="gimbal_yaw">
      <pose>0.0658 0.0015 -0.1159 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.08</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <visual name="vertical_arm_visual">
        <pose>-0.025 0 0.10 0 0 0</pose>
        <geometry><mesh><uri>model://plane_gimbal/meshes/cgo3_vertical_arm_remeshed_v1.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="horizontal_arm_visual">
        <pose>-0.024 0 0.10 0 0 0</pose>
        <geometry><mesh><uri>model://plane_gimbal/meshes/cgo3_horizontal_arm_remeshed_v1.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="gimbal_yaw_joint" type="revolute">
      <parent>gimbal_mount</parent><child>gimbal_yaw</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-3.14159</lower><upper>3.14159</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <link name="gimbal_pitch">
      <pose>0 0 -0.18 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.12</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial>
      <visual name="payload_visual">
        <pose>-0.0418 -0.0015 0.1641 0 0 3.14159265</pose>
        <geometry><mesh><uri>model://plane_gimbal/meshes/cgo3_camera_remeshed_v1.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="optical_window_visual">
        <pose>0.036 0 0 0 1.57079633 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.01 0.05 0.08 1</ambient><diffuse>0.03 0.18 0.28 1</diffuse></material>
      </visual>
      
      <sensor name="gimbal_camera" type="camera">
        <always_on>true</always_on><update_rate>20</update_rate>
        <camera><horizontal_fov>1.0472</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>30.0</far></clip></camera>
        <plugin name="gimbal_camera_ros" filename="libgazebo_ros_camera.so">
          <robotNamespace>/uav1</robotNamespace><cameraName>gimbal_camera</cameraName>
          <imageTopicName>image_raw</imageTopicName><cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>uav1/gimbal_camera_optical</frameName>
        </plugin>
      </sensor>
      
      
      <sensor name="laser_range" type="ray">
        <always_on>true</always_on><update_rate>20</update_rate>
        <ray><scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal><vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.2</min><max>30.0</max><resolution>0.001</resolution></range></ray>
        <plugin name="laser_range_ros" filename="libgazebo_ros_range.so">
          <robotNamespace>/uav1</robotNamespace><topicName>gimbal/range</topicName>
          <frameName>uav1/gimbal_laser</frameName><radiation>infrared</radiation><fov>0.001</fov>
          <updateRate>20</updateRate><gaussianNoise>0.0</gaussianNoise>
        </plugin>
      </sensor>
      
    </link>
    <joint name="gimbal_pitch_joint" type="revolute">
      <parent>gimbal_yaw</parent><child>gimbal_pitch</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1.5708</lower><upper>1.5708</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    
    <plugin name="gimbal_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <robotNamespace>/uav1</robotNamespace>
      <jointName>gimbal_yaw_joint, gimbal_pitch_joint</jointName>
      <updateRate>50</updateRate><alwaysOn>true</alwaysOn>
    </plugin>
    <plugin name="gimbal_joint_trajectory" filename="libxd_uav_detect_gimbal_joint_controller.so">
      <robotNamespace>/uav1</robotNamespace>
      <topicName>gimbal/set_joint_trajectory</topicName>
      <positionP>0.2</positionP><positionI>0.0</positionI><positionD>0.01</positionD>
      <maximumEffort>0.2</maximumEffort>
    </plugin>
    <!-- XD_UAV_DETECT_EO_GIMBAL_END -->
  </model>
</sdf>
