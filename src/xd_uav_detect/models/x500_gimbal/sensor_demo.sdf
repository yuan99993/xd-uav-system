    <!-- Test fixture only: canonical model.sdf retains all flight plugins. -->
    <joint name="sensor_demo_world_anchor" type="fixed">
      <parent>world</parent><child>base_link</child>
    </joint>

<!-- XD_UAV_DETECT_EO_GIMBAL_BEGIN -->
    <!-- +X is the shared camera/range boresight. -->
    <link name="gimbal_mount">
      <pose>0.0918 0.0015 0.02 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.02</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial>
      <visual name="mount_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry><mesh><uri>model://x500_gimbal/meshes/cgo3_mount_remeshed_v1.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="gimbal_mount_joint" type="fixed">
      <parent>base_link</parent><child>gimbal_mount</child>
    </joint>
    <link name="gimbal_yaw">
      <pose>0.0658 0.0015 -0.08 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.08</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <visual name="vertical_arm_visual">
        <pose>-0.025 0 0.10 0 0 0</pose>
        <geometry><mesh><uri>model://x500_gimbal/meshes/cgo3_vertical_arm_remeshed_v1.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="horizontal_arm_visual">
        <pose>-0.024 0 0.10 0 0 0</pose>
        <geometry><mesh><uri>model://x500_gimbal/meshes/cgo3_horizontal_arm_remeshed_v1.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
    </link>
    <joint name="gimbal_yaw_joint" type="revolute">
      <parent>gimbal_mount</parent><child>gimbal_yaw</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-3.14159</lower><upper>3.14159</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    <link name="gimbal_pitch">
      <pose>0 0 -0.1441 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.12</mass><inertia><ixx>0.0002</ixx><iyy>0.0002</iyy><izz>0.0002</izz></inertia></inertial>
      <visual name="payload_visual">
        <pose>-0.0418 -0.0015 0.1641 0 0 3.14159265</pose>
        <geometry><mesh><uri>model://x500_gimbal/meshes/cgo3_camera_remeshed_v1.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="optical_window_visual">
        <pose>0.036 0 0 0 1.57079633 0</pose>
        <geometry><cylinder><radius>0.012</radius><length>0.002</length></cylinder></geometry>
        <material><ambient>0.01 0.05 0.08 1</ambient><diffuse>0.03 0.18 0.28 1</diffuse></material>
      </visual>
      
      <sensor name="gimbal_camera" type="camera">
        <always_on>true</always_on><update_rate>20</update_rate>
        <camera><horizontal_fov>1.0472</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>30.0</far></clip></camera>
        <plugin name="gimbal_camera_ros" filename="libgazebo_ros_camera.so">
          <robotNamespace>/uav1</robotNamespace><cameraName>gimbal_camera</cameraName>
          <imageTopicName>image_raw</imageTopicName><cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>uav1/gimbal_camera_optical</frameName>
        </plugin>
      </sensor>
      
      
      <sensor name="laser_range" type="ray">
        <always_on>true</always_on><update_rate>20</update_rate>
        <ray><scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal><vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.2</min><max>30.0</max><resolution>0.001</resolution></range></ray>
        <plugin name="laser_range_ros" filename="libgazebo_ros_range.so">
          <robotNamespace>/uav1</robotNamespace><topicName>gimbal/range</topicName>
          <frameName>uav1/gimbal_laser</frameName><radiation>infrared</radiation><fov>0.001</fov>
          <updateRate>20</updateRate><gaussianNoise>0.0</gaussianNoise>
        </plugin>
      </sensor>
      
    </link>
    <joint name="gimbal_pitch_joint" type="revolute">
      <parent>gimbal_yaw</parent><child>gimbal_pitch</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1.5708</lower><upper>1.5708</upper></limit><dynamics><damping>0.01</damping></dynamics></axis>
    </joint>
    
    <plugin name="gimbal_joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <robotNamespace>/uav1</robotNamespace>
      <jointName>gimbal_yaw_joint, gimbal_pitch_joint</jointName>
      <updateRate>50</updateRate><alwaysOn>true</alwaysOn>
    </plugin>
    <plugin name="gimbal_joint_trajectory" filename="libxd_uav_detect_gimbal_joint_controller.so">
      <robotNamespace>/uav1</robotNamespace>
      <topicName>gimbal/set_joint_trajectory</topicName>
      <positionP>0.2</positionP><positionI>0.0</positionI><positionD>0.01</positionD>
      <maximumEffort>0.2</maximumEffort>
    </plugin>
    <!-- XD_UAV_DETECT_EO_GIMBAL_END -->
  </model>
</sdf>
