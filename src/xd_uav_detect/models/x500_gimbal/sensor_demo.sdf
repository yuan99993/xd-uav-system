    <!-- GPS {-->
    <link name="gps0_link">
  <pose>0 0 0 0 0 0</pose>
  <inertial>
    <mass>0.00001</mass>
    <inertia>
      <ixx>1e-7</ixx>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyy>1e-7</iyy>
      <iyz>0</iyz>
      <izz>1e-7</izz>
    </inertia>
  </inertial>
  <sensor name="gps_sensor" type="gps">
    </sensor>
</link>

<joint name='gps0_joint' type='fixed'>
  <child>gps0_link</child>
  <parent>base_link</parent>
</joint>
