      <!-- GPS mount {-->
      <link name="gps_mount_link">
    <inertial>
    <mass>0.00001</mass>
    <inertia>
      <ixx>1e-7</ixx>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyy>1e-7</iyy>
      <iyz>0</iyz>
      <izz>1e-7</izz>
    </inertia>
  </inertial>
    <pose>0 0 0 0 0 1.5707963267948966</pose>
    <visual name="gps_mount_visual">
    <pose>0 0 0 0 0 0</pose>
    <geometry>
      <mesh>
        <uri>model://x500_gimbal/meshes/gps_mount_mesh_file.stl</uri>
        <scale>1 1 1</scale>
      </mesh>
    </geometry>
    <material>
      <script>
        <name>Gazebo/Grey</name>
        <uri>file://media/materials/scripts/gazebo.material</uri>
      </script>
    </material>
  </visual>
  </link>
  <joint name="gps_mount_joint" type="fixed">
    <child>gps_mount_link</child>
    <parent>base_link</parent>
  </joint>
      <!--}-->

      <!-- GPS antenna {-->
      <link name="gps_module_link">
    <inertial>
    <mass>0.00001</mass>
    <inertia>
      <ixx>1e-7</ixx>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyy>1e-7</iyy>
      <iyz>0</iyz>
      <izz>1e-7</izz>
    </inertia>
  </inertial>
    <pose>0 0 0 0 0 1.5707963267948966</pose>
    <visual name="gps_module_visual">
    <pose>0 0 0 0 0 0</pose>
    <geometry>
      <mesh>
        <uri>model://x500_gimbal/meshes/gps_module_mesh_file.stl</uri>
        <scale>1 1 1</scale>
      </mesh>
    </geometry>
    <material>
      <script>
        <name>Gazebo/Black</name>
        <uri>file://media/materials/scripts/gazebo.material</uri>
      </script>
    </material>
  </visual>
  </link>
  <joint name="gps_module_joint" type="fixed">
    <child>gps_module_link</child>
    <parent>base_link</parent>
  </joint>
