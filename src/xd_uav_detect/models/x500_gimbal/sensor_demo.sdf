    <!-- IMU {-->
    <!-- NOTE: IMU has to be last, otherwise the simulation is extremely slow! -->
    <link name="imu_link">
    <pose>0 0 0 0 0 0</pose>
    <inertial>
    <mass>0.00001</mass>
    <inertia>
      <ixx>1e-7</ixx>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyy>1e-7</iyy>
      <iyz>0</iyz>
      <izz>1e-7</izz>
    </inertia>
  </inertial>
  </link>
  <joint name="imu_joint" type="revolute">
    <parent>base_link</parent>
    <child>imu_link</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <upper>0</upper>
        <lower>0</lower>
        <effort>0</effort>
        <velocity>0</velocity>
      </limit>
      <use_parent_model_frame>1</use_parent_model_frame>
    </axis>
  </joint>
  <!--}-->

