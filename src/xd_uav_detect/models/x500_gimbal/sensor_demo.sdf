  <!-- Propellers {--><!-- Propeller 0 {-->
      <link name="prop_0_link">
    <pose>0.1812 -0.1812 0.057 0 0 0</pose>
    <inertial>
      <mass>0.005</mass>
      <inertia>
        <ixx>0.0001</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.0001</iyy>
        <iyz>0</iyz>
        <izz>0.0001</izz>
      </inertia>
    </inertial>
    <visual name="prop_{{ motor_number }}_first_visual">
  <pose>0 0 0 0 0 0</pose>
  <geometry>
    <mesh>
      <uri>model://x500_gimbal/meshes/prop_mesh_file.dae</uri>
      <scale>1 1 1</scale>
    </mesh>
  </geometry>
</visual>
    <visual name="prop_{{ motor_number }}_second_visual">
    <pose>0 0 -0.0086 0 0 0</pose>
    <geometry>
      <mesh>
        <uri>model://x500_gimbal/meshes/motor_top_mesh_file.stl</uri>
        <scale>1 1 1</scale>
      </mesh>
    </geometry>
    <material>
      <script>
        <name>Gazebo/Grey</name>
        <uri>file://media/materials/scripts/gazebo.material</uri>
      </script>
    </material>
  </visual>
    <collision name="prop_{{ motor_number }}_link_collision">
    <pose>0 0 0 0 1.5707963267948966 0</pose>
    <geometry>
      <cylinder>
        <length>0.3302</length>
        <radius>0.01</radius>
      </cylinder>
    </geometry>
    <surface>
      <contact>
        <ode>
          <min_depth>0.01</min_depth>
          <max_vel>0.0</max_vel>
        </ode>
      </contact>
      <friction>
        <ode/>
      </friction>
    </surface>
  </collision>
  </link>
  <joint name="prop_0_joint" type="revolute">
    <parent>base_link</parent>
    <child>prop_0_link</child>
    <axis>
      <xyz>0 0 1</xyz>
      <limit>
        <lower>-1e+16</lower>
        <upper>1e+16</upper>
      </limit>
      <dynamics>
        <spring_reference>0</spring_reference>
        <spring_stiffness>0</spring_stiffness>
      </dynamics>
      <use_parent_model_frame>1</use_parent_model_frame>
    </axis>
  </joint>
      <!--}--><!-- Propeller 1 {-->
      <link name="prop_1_link">
    <pose>-0.1812 0.1812 0.057 0 0 0</pose>
    <inertial>
      <mass>0.005</mass>
      <inertia>
        <ixx>0.0001</ixx>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyy>0.0001</iyy>
        <iyz>0</iyz>
        <izz>0.0001</izz>
