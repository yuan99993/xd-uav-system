  <model name="x500_gimbal">

    
    
    

    <link name="base_link">

      <!-- Body physics {-->
      <inertial>
    <mass>2.0</mass>
    <inertia>
      <ixx>0.03166666666666667</ixx>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyy>0.03166666666666667</iyy>
      <iyz>0</iyz>
      <izz>0.0625</izz>
    </inertia>
  </inertial>
  <collision name="base_link_collision">
    <pose>
      <x>0</x>
      <y>0</y>
      <z>-0.05</z>
      <roll>0</roll>
      <pitch>0</pitch>
      <yaw>0</yaw>
    </pose>
    <geometry>
      <cylinder>
        <length>0.1</length>
        <radius>0.1</radius>
      </cylinder>
    </geometry>
    <surface>
      <contact>
        <ode>
          <min_depth>0.001</min_depth>
          <max_vel>0.0</max_vel>
        </ode>
      </contact>
      <friction>
        <ode/>
      </friction>
    </surface>
  </collision>

  <!--}-->

