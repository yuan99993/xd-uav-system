<?xml version="1.0" encoding="utf-8"?>
<sdf version="1.6">
  
  

  

  

  
  

  

  

  

  

  

  

  

  

  <model name="x500_gimbal">

    
    
    

    <link name="base_link">

      <!-- Body physics {-->
      <inertial>
    <mass>2.0</mass>
    <inertia>
      <ixx>0.03166666666666667</ixx>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyy>0.03166666666666667</iyy>
      <iyz>0</iyz>
      <izz>0.0625</izz>
    </inertia>
  </inertial>
  <collision name="base_link_collision">
    <pose>
      <x>0</x>
      <y>0</y>
      <z>-0.05</z>
      <roll>0</roll>
      <pitch>0</pitch>
      <yaw>0</yaw>
    </pose>
    <geometry>
      <cylinder>
        <length>0.1</length>
        <radius>0.1</radius>
      </cylinder>
    </geometry>
    <surface>
      <contact>
        <ode>
          <min_depth>0.001</min_depth>
          <max_vel>0.0</max_vel>
        </ode>
      </contact>
      <friction>
        <ode/>
      </friction>
    </surface>
  </collision>

  <plugin filename="libgazebo_multirotor_base_plugin.so" name="multirotor_base_plugin">
    <robotNamespace/>
    <linkName>base_link</linkName>
    <rotorVelocitySlowdownSim>0.0159236</rotorVelocitySlowdownSim>
  </plugin>
      <!--}-->

      <!-- Body visuals {-->

      <!-- Boards {-->
      <visual name="top_board_visual">
  <pose>0 0 0 0 0 1.5707963267948966</pose>
  <geometry>
    <mesh>
      <uri>model://x500_gimbal/meshes/top_board_mesh_file.dae</uri>
      <scale>1 1 1</scale>
    </mesh>
  </geometry>
</visual>

