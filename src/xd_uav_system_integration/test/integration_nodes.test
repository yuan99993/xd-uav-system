<launch>
  <group ns="uav1">
    <node pkg="xd_uav_system_integration" type="state_hold_baseline_node.py"
          name="state_hold_baseline" required="true">
      <param name="common_frame" value="world"/>
    </node>
    <node pkg="xd_uav_system_integration" type="health_gate_node.py"
          name="ego_system_health" required="true">
      <rosparam param="inputs">[ego/bridge/healthy, ego/sensing/healthy]</rosparam>
      <param name="timeout" value="0.15"/>
      <param name="output" value="ego/system_healthy"/>
    </node>
    <node pkg="xd_uav_system_integration" type="reference_mux_node.py"
          name="reference_mux" required="true">
      <param name="initial_owner" value="none"/>
      <param name="common_frame" value="world"/>
      <param name="candidate_timeout" value="0.20"/>
      <param name="health_timeout" value="0.20"/>
      <param name="ego_healthy_topic" value="ego/system_healthy"/>
      <param name="output_topic" value="control/reference/setpoint"/>
    </node>
  </group>
  <test test-name="integration_nodes"
        pkg="xd_uav_system_integration"
        type="test_integration_nodes.py"
        time-limit="20"/>
</launch>
