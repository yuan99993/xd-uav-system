<?xml version="1.0"?>
<launch>
  <arg name="UAV_NAME" default="uav1"/>
  <arg name="common_frame" default="world"/>
  <arg name="gps_origin_topic" default="mavros/global_position/gp_origin"/>
  <include file="$(find xd_uav_system_integration)/launch/mavros_odom_recovery_gate.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
  </include>
  <group ns="$(arg UAV_NAME)">
    <node pkg="xd_uav_system_integration" type="imu_frame_adapter.py"
          name="imu_frame_adapter" output="screen" required="true">
      <param name="input_topic" value="mavros/imu/data"/>
      <param name="output_topic" value="integration/imu_base_link"/>
      <param name="frame_id" value="$(arg UAV_NAME)/base_link"/>
    </node>
  </group>
  <include file="$(find xd_uav_system_integration)/launch/px4_control_stack.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="common_frame" value="$(arg common_frame)"/>
    <arg name="gps_origin_topic" value="$(arg gps_origin_topic)"/>
    <arg name="simple_goal_topic" value="/$(arg UAV_NAME)/demo/simple_goal"/>
    <arg name="adapt_manager_imu" value="true"/>
    <arg name="sources_config"
         value="$(find xd_uav_system_integration)/config/px4_mavros_sources_guarded.yaml"/>
  </include>
</launch>
