<?xml version="1.0"?>
<launch>
  <arg name="UAV_NAME" default="uav1"/>
  <arg name="common_frame" default="world"/>
  <arg name="simple_goal_topic"
       default="/$(arg UAV_NAME)/integration/disabled_simple_goal"/>
  <arg name="adapt_manager_imu" default="false"/>

  <include file="$(find xd_uav_system_integration)/launch/world_registration.launch"/>

  <arg name="sources_config"
       default="$(find xd_uav_system_integration)/config/px4_mavros_sources.yaml"/>
  <arg name="controller_config"
       default="$(find xd_uav_system_integration)/config/px4_x500_multirotor.yaml"/>

  <include file="$(find xd_uav_state_estimators)/launch/odometry_adapter_manager.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="sources_config" value="$(arg sources_config)"/>
  </include>

  <include file="$(find xd_uav_state_estimators)/launch/estimator.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="sources_config" value="$(arg sources_config)"/>
    <arg name="body_frame" value="$(arg UAV_NAME)/base_link"/>
  </include>

  <include file="$(find xd_uav_single_tf_manager)/launch/single_tf.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="body_frame" value="$(arg UAV_NAME)/base_link"/>
  </include>

  <include unless="$(arg adapt_manager_imu)"
           file="$(find xd_uav_control_manager)/launch/control_manager.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="vehicle_type" value="multirotor"/>
  </include>
  <include if="$(arg adapt_manager_imu)"
           file="$(find xd_uav_system_integration)/launch/control_manager_guarded.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
  </include>

  <include file="$(find xd_uav_controller)/launch/controller.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="vehicle_type" value="multirotor"/>
    <arg name="config" value="$(arg controller_config)"/>
    <arg name="simple_goal_topic" value="$(arg simple_goal_topic)"/>
  </include>

  <include file="$(find xd_uav_system_integration)/launch/reference_integration.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="common_frame" value="$(arg common_frame)"/>
    <arg name="initial_owner" value="none"/>
  </include>
</launch>
