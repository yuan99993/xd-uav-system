<?xml version="1.0"?>
<sdf version="1.6">
  <model name="tracking_mountain">
    <static>true</static>
    <link name="rock">
      <!-- Collision is deliberately cheap; the two tank lanes never touch it. -->
      <collision name="base_collision">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry><cylinder><radius>8.0</radius><length>3.0</length></cylinder></geometry>
      </collision>
      <visual name="main_peak">
        <geometry><mesh><uri>model://tracking_mountain/meshes/pointed_rock.stl</uri></mesh></geometry>
        <material><ambient>0.28 0.27 0.26 1</ambient><diffuse>0.51 0.49 0.47 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
      </visual>
      <visual name="side_peak">
        <pose>-3.4 1.4 0 0 0 0.35</pose>
        <geometry><mesh><uri>model://tracking_mountain/meshes/pointed_rock.stl</uri><scale>0.53 0.53 0.66</scale></mesh></geometry>
        <material><ambient>0.24 0.23 0.22 1</ambient><diffuse>0.43 0.42 0.40 1</diffuse><specular>0.04 0.04 0.04 1</specular></material>
      </visual>
    </link>
  </model>
</sdf>
