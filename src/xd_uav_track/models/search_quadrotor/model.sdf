        <material><ambient>0.24 0.26 0.28 0.75</ambient><diffuse>0.32 0.34 0.36 0.75</diffuse></material>
      </visual>
      <sensor name="fixed_camera" type="camera">
        <pose>0.10 0 -0.16 0 1.57079632679 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.22</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.25</near><far>150</far></clip>
        </camera>
        <plugin name="fixed_camera_ros" filename="libgazebo_ros_camera.so">
          <robotNamespace>/moving_uav_search</robotNamespace>
          <cameraName>fixed_camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>moving_uav_search/fixed_camera_optical_frame</frameName>
          <updateRate>10</updateRate>
        </plugin>
