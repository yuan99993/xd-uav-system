<?xml version="1.0"?>
<sdf version="1.6">
  <model name="search_quadrotor">
    <static>false</static>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="base_link">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <inertial>
        <mass>2.0</mass>
        <inertia><ixx>0.08</ixx><iyy>0.08</iyy><izz>0.12</izz></inertia>
      </inertial>
      <visual name="body">
        <geometry><box><size>0.48 0.38 0.12</size></box></geometry>
        <material><ambient>0.10 0.12 0.14 1</ambient><diffuse>0.16 0.19 0.22 1</diffuse></material>
      </visual>
      <visual name="front_marker">
        <pose>0.19 0 0.072 0 0 0</pose>
        <geometry><box><size>0.10 0.24 0.025</size></box></geometry>
        <material><ambient>0.95 0.32 0.06 1</ambient><diffuse>1.0 0.42 0.08 1</diffuse></material>
      </visual>
      <visual name="arm_front_left">
        <pose>0.23 0.23 0.015 0 0 0.7853981634</pose>
        <geometry><box><size>0.72 0.055 0.045</size></box></geometry>
        <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.18 0.20 0.22 1</diffuse></material>
      </visual>
      <visual name="arm_rear_left">
        <pose>-0.23 0.23 0.015 0 0 -0.7853981634</pose>
        <geometry><box><size>0.72 0.055 0.045</size></box></geometry>
        <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.18 0.20 0.22 1</diffuse></material>
      </visual>
      <visual name="arm_front_right">
        <pose>0.23 -0.23 0.015 0 0 -0.7853981634</pose>
        <geometry><box><size>0.72 0.055 0.045</size></box></geometry>
        <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.18 0.20 0.22 1</diffuse></material>
      </visual>
      <visual name="arm_rear_right">
        <pose>-0.23 -0.23 0.015 0 0 0.7853981634</pose>
        <geometry><box><size>0.72 0.055 0.045</size></box></geometry>
        <material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.18 0.20 0.22 1</diffuse></material>
      </visual>
      <visual name="rotor_front_left">
        <pose>0.48 0.48 0.055 0 0 0</pose>
        <geometry><cylinder><radius>0.18</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.24 0.26 0.28 0.75</ambient><diffuse>0.32 0.34 0.36 0.75</diffuse></material>
      </visual>
      <visual name="rotor_front_right">
        <pose>0.48 -0.48 0.055 0 0 0</pose>
        <geometry><cylinder><radius>0.18</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.24 0.26 0.28 0.75</ambient><diffuse>0.32 0.34 0.36 0.75</diffuse></material>
      </visual>
      <visual name="rotor_rear_left">
        <pose>-0.48 0.48 0.055 0 0 0</pose>
        <geometry><cylinder><radius>0.18</radius><length>0.025</length></cylinder></geometry>
        <material><ambient>0.24 0.26 0.28 0.75</ambient><diffuse>0.32 0.34 0.36 0.75</diffuse></material>
      </visual>
      <visual name="rotor_rear_right">
