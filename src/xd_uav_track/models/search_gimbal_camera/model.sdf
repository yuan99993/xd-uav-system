<?xml version="1.0"?>
<sdf version="1.6">
  <model name="search_gimbal_camera">
    <static>false</static>
    <allow_auto_disable>false</allow_auto_disable>
    <link name="gimbal_link">
      <gravity>false</gravity>
      <kinematic>true</kinematic>
      <inertial>
        <mass>0.15</mass>
        <inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz></inertia>
      </inertial>
      <visual name="housing">
        <geometry><cylinder><radius>0.09</radius><length>0.13</length></cylinder></geometry>
        <material><ambient>0.07 0.08 0.09 1</ambient><diffuse>0.12 0.14 0.15 1</diffuse></material>
      </visual>
      <visual name="lens">
        <pose>0.075 0 0 0 1.57079632679 0</pose>
        <geometry><cylinder><radius>0.035</radius><length>0.035</length></cylinder></geometry>
        <material><ambient>0.02 0.03 0.04 1</ambient><diffuse>0.04 0.06 0.08 1</diffuse></material>
      </visual>
      <sensor name="gimbal_camera" type="camera">
        <!-- Camera looks obliquely down; the mount yaw is swept by the test driver. -->
        <pose>0 0 0 0 0.95 0</pose>
        <always_on>true</always_on>
        <update_rate>4</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.25</near><far>150</far></clip>
        </camera>
        <plugin name="search_gimbal_camera_ros" filename="libgazebo_ros_camera.so">
          <robotNamespace>/moving_uav_search</robotNamespace>
          <cameraName>gimbal_camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>moving_uav_search/gimbal_camera_optical_frame</frameName>
          <updateRate>4</updateRate>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
