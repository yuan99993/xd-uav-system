<?xml version="1.0"?>
<sdf version="1.5">
  <!-- Per-UAV template. render_plane_catapult_sdf.py replaces __UAV_NAME__. -->
  <model name="plane_catapult">
    <include>
      <uri>model://plane</uri>
      <name>plane</name>
      <pose>0 0 0.30 0 0 0</pose>
    </include>
    <link name="payload_link">
      <pose>0 0 0.20 0 1.57079632679 0</pose>
      <inertial>
        <mass>0.02</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
      </inertial>
      <sensor name="down_camera" type="camera">
        <always_on>true</always_on><update_rate>20</update_rate><visualize>false</visualize>
        <camera>
          <horizontal_fov>2.85</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.20</near><far>500</far></clip>
        </camera>
        <plugin name="down_camera_ros" filename="libgazebo_ros_camera.so">
          <robotNamespace>/__UAV_NAME__</robotNamespace>
          <cameraName>down_camera</cameraName><imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>__UAV_NAME__/down_camera_optical_frame</frameName>
          <updateRate>20</updateRate>
        </plugin>
      </sensor>
      <sensor name="down_lrf" type="ray">
        <always_on>true</always_on><update_rate>20</update_rate>
        <ray><scan><horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal><vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.5</min><max>500</max><resolution>0.02</resolution></range></ray>
        <plugin name="down_lrf_ros" filename="libgazebo_ros_range.so">
          <robotNamespace>/__UAV_NAME__</robotNamespace><topicName>gimbal/range</topicName>
          <frameName>__UAV_NAME__/down_lrf_frame</frameName><radiation>infrared</radiation>
          <fov>0.01</fov><gaussianNoise>0.02</gaussianNoise><updateRate>20</updateRate>
        </plugin>
      </sensor>
    </link>
    <joint name="payload_fixed_joint" type="fixed"><parent>plane::base_link</parent><child>payload_link</child></joint>
    <plugin name="catapult_plugin" filename="libgazebo_catapult_plugin.so">
      <!-- The outer model owns payload_link; Gazebo does not expose an
           included model's scoped link through Model::GetLink reliably.
           Applying the launch force to this rigidly-jointed link keeps the
           catapult functional across Gazebo versions. -->
      <robotNamespace></robotNamespace><link_name>payload_link</link_name>
      <motorNumber>4</motorNumber><commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>
      <force>25.0</force><duration>0.80</duration><hold_before_launch>true</hold_before_launch>
      <direction_x>1.0</direction_x><direction_y>0.0</direction_y><direction_z>0.35</direction_z>
    </plugin>
  </model>
</sdf>
