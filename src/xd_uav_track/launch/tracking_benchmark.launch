<launch>
  <!-- Low-load visual target benchmark; no PX4, MAVROS, detector or tracker is started. -->
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="verbose" default="false"/>
  <arg name="rate_hz" default="20.0"/>

  <!-- Make only this package's procedural models visible to Gazebo. -->
  <env name="GAZEBO_MODEL_PATH" value="$(find xd_uav_track)/models:$(optenv GAZEBO_MODEL_PATH)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find xd_uav_track)/worlds/tracking_benchmark.world"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="verbose" value="$(arg verbose)"/>
    <arg name="headless" value="false"/>
  </include>

  <node pkg="xd_uav_track" type="tracking_benchmark_driver.py"
        name="tracking_benchmark_driver" output="screen" required="true">
    <param name="rate_hz" value="$(arg rate_hz)"/>
    <param name="benchmark_namespace" value="tracking_benchmark"/>
  </node>
</launch>
