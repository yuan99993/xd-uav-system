<launch>
  <arg name="UAV_NAME" default="uav1"/>
  <arg name="record_decisions" default="false"/>
  <arg name="decision_file" default="/tmp/tracking-decisions.jsonl"/>
  <node if="$(arg record_decisions)" pkg="xd_uav_track"
        type="record_tracking_decisions.py" name="tracking_decisions"
        args="--namespace /$(arg UAV_NAME) --output $(arg decision_file)" output="screen"/>
</launch>
