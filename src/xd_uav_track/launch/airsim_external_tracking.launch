<launch>
  <!-- External (Project AirSim / UE) fixed-camera vehicle detection + tracking.

       For the tegra-ubuntu board when:
         * roscore runs on another host (external simulation, e.g. 192.168.2.98)
         * the downward camera comes from AirSim, not Gazebo
         * the frame tree root is `map` (there is NO `world` frame)

       Chain: sar_yolo_detector -> xd_uav_detect (ground projection)
              -> xd_uav_track (tracker + follower) -> tracking overlay

       Run:
         export ROS_MASTER_URI=http://192.168.2.98:11311
         export ROS_IP=192.168.2.102
         export DISPLAY=:0
         roslaunch xd_uav_track airsim_external_tracking.launch
  -->

  <arg name="UAV_NAME" default="uav1"/>

  <!-- ===== AirSim camera wiring (verified live on this host) ===== -->
  <!-- Image:       ~8-11 Hz, 1280x720, frame_id = .../Drone2/sensors/DownCamera -->
  <arg name="fixed_image_topic"
       default="/Sim/SceneBasicDrone/robots/Drone2/sensors/FrontCamera/scene_camera/image"/>
  <arg name="fixed_camera_info_topic"
       default="/Sim/SceneBasicDrone/robots/Drone2/sensors/FrontCamera/scene_camera/camera_info"/>

  <!-- ===== TF frames =====
       The AirSim TF tree is rooted at `map`, NOT `world`:
         map -> Sim/SceneBasicDrone/robots/Drone2 -> .../sensors/DownCamera
       We therefore use `map` as the ground-projection world frame. -->
  <arg name="world_frame" default="map"/>
  <arg name="camera_frame"
       default="Sim/SceneBasicDrone/robots/Drone2/sensors/DownCamera"/>
  <arg name="body_frame"
       default="Sim/SceneBasicDrone/robots/Drone2"/>

  <!-- ===== Behaviour switches ===== -->
  <arg name="show_overlay" default="true"/>
  <arg name="enable_reid" default="true"/>
  <arg name="detector_fps" default="4.0"/>
  <arg name="overlay_fps" default="8.0"/>

  <!-- The tracker follows `control/reference/*`. Set this to false to run
       recognition + tracking only and never emit a control reference. -->
  <arg name="publish_control_reference" default="false"/>

  <!-- ===== Model / backend ===== -->
  <arg name="detector_config"
       default="$(find sar_yolo_detector)/config/xd_vehicle_detection.yaml"/>
  <arg name="projection_config"
       default="$(find xd_uav_track)/config/moving_uav_search_ground_projection.yaml"/>
  <arg name="tracker_base_config" default="$(find xd_uav_track)/config/track.yaml"/>
  <arg name="tracker_config"
       default="$(find xd_uav_track)/config/moving_uav_search_tracker.yaml"/>
  <arg name="model_path"
       default="$(find sar_yolo_detector)/models/xd_vehicle_train7/xd_vehicle_train7.pt"/>
  <arg name="model_sha256"
       default="8f2506e1fd9585eab0d23203f504ff0036d580327e55ef15d23bd9e46fd34b54"/>
  <arg name="model_version" default="xd_vehicle_train7_best"/>

  <!-- Use the verified .pt on CUDA: the repo TensorRT engine was built by a
       different TRT runtime on this host. -->
  <arg name="inference_backend" default="cuda_torch"/>
  <arg name="engine_path"
       default="$(find sar_yolo_detector)/models/xd_vehicle_train7/xd_vehicle_train7.engine"/>
  <arg name="engine_sha256"
       default="88ed19419dcefdf64f6c90f31aa7961ef906c31d3581633afba69fa586bc850f"/>
  <arg name="engine_source_model_sha256"
       default="8f2506e1fd9585eab0d23203f504ff0036d580327e55ef15d23bd9e46fd34b54"/>
  <arg name="auto_export_engine" default="true"/>
  <arg name="engine_cache_dir" default="~/.cache/sar_yolo_detector/tensorrt"/>

  <arg name="fixed_image_source" default="search_fixed"/>
  <arg name="fixed_sensor_id" default="airsim_drone2_down_camera"/>
  <arg name="detector_name" default="sar_yolo_detector"/>

  <env name="QT_QPA_PLATFORM" value="xcb"/>

  <!-- ============ 1. Detector: shared YOLO on the AirSim image ============ -->
  <include file="$(find sar_yolo_detector)/launch/xd_yolo_multi_source_detection_integration.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="config" value="$(arg detector_config)"/>
    <arg name="model_path" value="$(arg model_path)"/>
    <arg name="model_sha256" value="$(arg model_sha256)"/>
    <arg name="model_version" value="$(arg model_version)"/>
    <arg name="inference_backend" value="$(arg inference_backend)"/>
    <arg name="engine_path" value="$(arg engine_path)"/>
    <arg name="engine_sha256" value="$(arg engine_sha256)"/>
    <arg name="engine_source_model_sha256" value="$(arg engine_source_model_sha256)"/>
    <arg name="auto_export_engine" value="$(arg auto_export_engine)"/>
    <arg name="engine_cache_dir" value="$(arg engine_cache_dir)"/>
    <arg name="maximum_batch_size" value="1"/>
    <arg name="startup_warmup_frames" value="1"/>
    <arg name="fixed_image_topic" value="$(arg fixed_image_topic)"/>
    <arg name="gimbal_image_topic" value="gimbal_camera/disabled_image"/>
    <arg name="fixed_output_topic" value="detect/input/fixed/detections_2d"/>
    <arg name="gimbal_output_topic" value="detect/input/gimbal/detections_2d"/>
    <arg name="fixed_image_source" value="$(arg fixed_image_source)"/>
    <arg name="gimbal_image_source" value="search_gimbal"/>
    <arg name="fixed_sensor_id" value="$(arg fixed_sensor_id)"/>
    <arg name="gimbal_sensor_id" value="disabled_gimbal"/>
    <arg name="fixed_detection_area" value="[0.0, 0.0, 1.0, 1.0]"/>
    <arg name="reid_enabled" value="$(arg enable_reid)"/>
    <arg name="fixed_reid_profile" value="xd_vehicle_train7"/>
    <arg name="tracking_tracks_topic" value="track/tracks"/>
    <arg name="discovery_max_fps" value="$(arg detector_fps)"/>
    <arg name="priority_max_fps" value="$(arg detector_fps)"/>
    <arg name="standby_max_fps" value="$(arg detector_fps)"/>
    <arg name="pixel_assist_enabled" value="true"/>
  </include>

  <!-- The stock integration launch hardcodes pause_without_subscribers=true,
       so the detector idles until its output topic already has a subscriber.
       Overriding it after the include lets detection start immediately and
       avoids a silent stall when the projector attaches late. -->
  <param name="/$(arg UAV_NAME)/sar_yolo_multi_source_detection/pause_without_subscribers"
         value="false"/>

  <!-- ============ 2. Ground projection: 2-D boxes -> metric 3-D ============
       world=map / camera=AirSim DownCamera / body=Drone2 -->
  <include file="$(find xd_uav_track)/launch/detect_instance.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="config" value="$(arg projection_config)"/>
    <arg name="node_name" value="fixed_camera_ground_projection"/>
    <arg name="body_frame" value="$(arg body_frame)"/>
    <arg name="world_frame" value="$(arg world_frame)"/>
    <arg name="camera_frame" value="$(arg camera_frame)"/>
    <arg name="image_source" value="$(arg fixed_image_source)"/>
    <arg name="sensor_id" value="$(arg fixed_sensor_id)"/>
    <arg name="detector_name" value="$(arg detector_name)"/>
    <arg name="image_topic" value="$(arg fixed_image_topic)"/>
    <arg name="camera_info_topic" value="$(arg fixed_camera_info_topic)"/>
    <arg name="detections_2d_topic" value="detect/input/fixed/detections_2d"/>
    <arg name="detections_3d_topic" value="track/detections"/>
    <arg name="status_topic" value="detect/fixed_ground_projection/status"/>
    <arg name="debug_image_topic" value="detect/fixed_ground_projection/debug_image"/>
  </include>

  <!-- ============ 3. Tracker + follower ============ -->
  <group ns="$(arg UAV_NAME)">
    <node pkg="xd_uav_track" type="xd_uav_track_node" name="track"
          output="screen" clear_params="true">
      <rosparam command="load" file="$(arg tracker_base_config)"/>
      <rosparam command="load" file="$(arg tracker_config)"/>
      <param name="frames/body" value="$(arg body_frame)"/>
      <param name="tracker/image_source" value="$(arg fixed_image_source)"/>
      <param name="runtime/publish_control_reference"
             value="$(arg publish_control_reference)"/>
      <!-- Start tracking immediately: no StartTracker gate in this setup. -->
      <param name="tracker/enabled_at_startup" value="true"/>
    </node>

    <!-- ============ 4. Tracking overlay (needs a live X display) ============ -->
    <node pkg="xd_uav_track" type="tracking_overlay_node.py"
          name="fixed_tracking_overlay" output="screen"
          if="$(arg show_overlay)">
      <param name="image_source" value="$(arg fixed_image_source)"/>
      <param name="input_image_topic" value="$(arg fixed_image_topic)"/>
      <param name="output_image_topic" value="fixed_camera/tracking_overlay"/>
      <param name="tracks_topic" value="track/tracks_by_source"/>
      <param name="status_topic" value="track/status"/>
      <param name="display_rate_hz" value="$(arg overlay_fps)"/>
      <param name="show_confirmed_only" value="true"/>
    </node>
  </group>
</launch>
