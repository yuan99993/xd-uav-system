<launch>
  <!-- Production vehicle pipeline: one train7 TensorRT detector serves both
       cameras; xd_uav_track alone owns identities and reacquisition. -->
  <arg name="UAV_NAME" default="$(optenv UAV_NAME uav1)"/>
  <arg name="vehicle_type" default="multirotor"/> <!-- multirotor | fixedwing -->
  <arg name="enable_tracking" default="true"/>
  <arg name="body_frame" default="$(arg UAV_NAME)/base_link"/>
  <arg name="world_frame" default="$(arg UAV_NAME)/local_origin"/>
  <arg name="enable_fixed_camera" default="true"/>
  <!-- Keep both subscriptions alive: cameras may publish after this stack starts. -->
  <arg name="enable_gimbal_lrf" default="true"/>
  <arg name="enable_sar_fixed" default="true"/>
  <arg name="enable_sar_gimbal" default="true"/>
  <arg name="fixed_detect_config" default="$(find xd_uav_detect)/config/multirotor_fixed_camera.yaml"/>
  <arg name="gimbal_detect_config" default="$(find xd_uav_detect)/config/gimbal_lrf_camera.yaml"/>
  <arg name="track_config" default="$(find xd_uav_track)/config/track.yaml"/>
  <arg name="fixed_image_topic" default="fixed_camera/image_raw"/>
  <arg name="fixed_camera_info_topic" default="fixed_camera/camera_info"/>
  <arg name="gimbal_image_topic" default="gimbal_camera/image_raw"/>
  <arg name="gimbal_camera_info_topic" default="gimbal_camera/camera_info"/>
  <arg name="fixed_image_source" default="fixed_rgb"/>
  <arg name="fixed_sensor_id" default="fixed_camera"/>
  <arg name="gimbal_image_source" default="gimbal_rgb"/>
  <arg name="gimbal_sensor_id" default="gimbal_camera"/>
  <arg name="detector_config" default="$(find sar_yolo_detector)/config/xd_vehicle_detection.yaml"/>
  <arg name="model_path" default="$(find sar_yolo_detector)/models/xd_vehicle_train7/xd_vehicle_train7.pt"/>
  <arg name="model_sha256" default="8f2506e1fd9585eab0d23203f504ff0036d580327e55ef15d23bd9e46fd34b54"/>
  <arg name="inference_backend" default="tensorrt_fp16"/>
  <arg name="engine_path" default="$(find sar_yolo_detector)/models/xd_vehicle_train7/xd_vehicle_train7.engine"/>
  <arg name="engine_sha256" default="88ed19419dcefdf64f6c90f31aa7961ef906c31d3581633afba69fa586bc850f"/>
  <arg name="engine_source_model_sha256" default="8f2506e1fd9585eab0d23203f504ff0036d580327e55ef15d23bd9e46fd34b54"/>
  <arg name="auto_export_engine" default="true"/>
  <arg name="detector_fps" default="4.0"/>
  <arg name="enable_reid" default="true"/>

  <include if="$(eval arg('enable_sar_fixed') or arg('enable_sar_gimbal'))"
           file="$(find sar_yolo_detector)/launch/xd_yolo_multi_source_detection_integration.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="config" value="$(arg detector_config)"/>
    <arg name="model_path" value="$(arg model_path)"/>
    <arg name="model_sha256" value="$(arg model_sha256)"/>
    <arg name="inference_backend" value="$(arg inference_backend)"/>
    <arg name="engine_path" value="$(arg engine_path)"/>
    <arg name="engine_sha256" value="$(arg engine_sha256)"/>
    <arg name="engine_source_model_sha256" value="$(arg engine_source_model_sha256)"/>
    <arg name="auto_export_engine" value="$(arg auto_export_engine)"/>
    <arg name="maximum_batch_size" value="1"/>
    <arg name="fixed_image_topic" value="$(eval arg('fixed_image_topic') if arg('enable_sar_fixed') else 'fixed_camera/disabled_image')"/>
    <arg name="gimbal_image_topic" value="$(eval arg('gimbal_image_topic') if arg('enable_sar_gimbal') else 'gimbal_camera/disabled_image')"/>
    <arg name="fixed_output_topic" value="detect/input/fixed/detections_2d"/>
    <arg name="gimbal_output_topic" value="detect/input/gimbal/detections_2d"/>
    <arg name="fixed_image_source" value="$(arg fixed_image_source)"/>
    <arg name="fixed_sensor_id" value="$(arg fixed_sensor_id)"/>
    <arg name="gimbal_image_source" value="$(arg gimbal_image_source)"/>
    <arg name="gimbal_sensor_id" value="$(arg gimbal_sensor_id)"/>
    <arg name="tracking_tracks_topic" value="$(eval 'track/tracks_by_source' if arg('enable_tracking') else '')"/>
    <arg name="pause_without_subscribers" value="$(eval 'true' if arg('enable_tracking') else 'false')"/>
    <arg name="reid_enabled" value="$(eval 'true' if arg('enable_tracking') and arg('enable_reid') else 'false')"/>
    <arg name="discovery_max_fps" value="$(arg detector_fps)"/>
    <arg name="priority_max_fps" value="$(arg detector_fps)"/>
    <arg name="standby_max_fps" value="$(arg detector_fps)"/>
    <arg name="pixel_assist_enabled" value="true"/>
  </include>

  <include if="$(eval arg('enable_tracking') and arg('enable_fixed_camera'))" file="$(find xd_uav_track)/launch/detect_instance.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="node_name" value="detect_fixed"/>
    <arg name="config" value="$(arg fixed_detect_config)"/>
    <arg name="body_frame" value="$(arg body_frame)"/>
    <arg name="world_frame" value="$(arg world_frame)"/>
    <arg name="image_source" value="$(arg fixed_image_source)"/>
    <arg name="sensor_id" value="$(arg fixed_sensor_id)"/>
    <arg name="detector_name" value="fixed_camera_detector"/>
    <arg name="image_topic" value="$(arg fixed_image_topic)"/>
    <arg name="camera_info_topic" value="$(arg fixed_camera_info_topic)"/>
    <arg name="detections_2d_topic" value="detect/input/fixed/detections_2d"/>
  </include>
  <include if="$(eval arg('enable_tracking') and arg('enable_gimbal_lrf'))" file="$(find xd_uav_track)/launch/detect_instance.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="node_name" value="detect_gimbal_lrf"/>
    <arg name="config" value="$(arg gimbal_detect_config)"/>
    <arg name="body_frame" value="$(arg body_frame)"/>
    <arg name="world_frame" value="$(arg world_frame)"/>
    <arg name="image_source" value="$(arg gimbal_image_source)"/>
    <arg name="sensor_id" value="$(arg gimbal_sensor_id)"/>
    <arg name="detector_name" value="gimbal_lrf_detector"/>
    <arg name="image_topic" value="$(arg gimbal_image_topic)"/>
    <arg name="camera_info_topic" value="$(arg gimbal_camera_info_topic)"/>
    <arg name="detections_2d_topic" value="detect/input/gimbal/detections_2d"/>
  </include>

  <include if="$(eval arg('enable_tracking') and arg('vehicle_type') == 'multirotor')" file="$(find xd_uav_track)/launch/track.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="body_frame" value="$(arg body_frame)"/>
    <arg name="config" value="$(arg track_config)"/>
  </include>
  <include if="$(eval arg('enable_tracking') and arg('vehicle_type') == 'fixedwing')" file="$(find xd_uav_track)/launch/track_fixedwing_sitl.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="body_frame" value="$(arg body_frame)"/>
    <arg name="config" value="$(arg track_config)"/>
  </include>
</launch>
