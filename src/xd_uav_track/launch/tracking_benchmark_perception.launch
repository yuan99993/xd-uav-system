<launch>
  <!-- Fixed-camera-only YOLO/tracker entry for a running benchmark scene.
       Gimbal perception and display remain stopped in this profile. -->
  <arg name="UAV_NAME" default="tracking_benchmark"/>
  <arg name="use_gpu" default="true"/>
  <!-- The low-load visual demo does not wait for the optional CPU ReID model. -->
  <arg name="enable_reid" default="true"/>
  <arg name="fixed_reid_profile" default="xd_vehicle_train7"/>
  <arg name="show_overlay" default="true"/>
  <arg name="camera_detection_max_fps" default="4.0"/>
  <arg name="pixel_assist_enabled" default="true"/>
  <!-- Follow each 6 Hz camera frame; YOLO may still run at only 4 Hz. -->
  <arg name="overlay_display_rate_hz" default="8.0"/>
  <arg name="overlay_maximum_pair_delta_sec" default="0.40"/>
  <arg name="detector_config" default="$(find sar_yolo_detector)/config/xd_vehicle_detection.yaml"/>
  <arg name="detector_overlay_config" default=""/>
  <arg name="model_path" default="$(find sar_yolo_detector)/models/xd_vehicle_train7/xd_vehicle_train7.pt"/>
  <arg name="model_sha256" default="8f2506e1fd9585eab0d23203f504ff0036d580327e55ef15d23bd9e46fd34b54"/>
  <arg name="model_version" default="xd_vehicle_train7_best"/>
  <arg name="inference_backend" default="tensorrt_fp16"/>
  <arg name="engine_path" default="$(find sar_yolo_detector)/models/xd_vehicle_train7/xd_vehicle_train7.engine"/>
  <arg name="engine_sha256" default="88ed19419dcefdf64f6c90f31aa7961ef906c31d3581633afba69fa586bc850f"/>
  <arg name="engine_source_model_sha256" default="8f2506e1fd9585eab0d23203f504ff0036d580327e55ef15d23bd9e46fd34b54"/>
  <arg name="auto_export_engine" default="true"/>
  <arg name="engine_cache_dir" default="~/.cache/sar_yolo_detector/tensorrt"/>
  <arg name="engine_builder_optimization_level" default="1"/>
  <arg name="engine_image_size" default="640"/>
  <arg name="engine_workspace_gib" default="0.5"/>
  <arg name="maximum_batch_size" default="1"/>
  <arg name="track_config" default="$(find xd_uav_track)/config/track.yaml"/>
  <arg name="benchmark_config" default="$(find xd_uav_track)/config/tracking_benchmark.yaml"/>

  <!-- Use Qt's rqt_image_view rather than the legacy GTK image_view binary:
       the latter can abort while destroying a non-registered GTK window on
       this desktop.  Keep the viewer on the X11 backend for a stable demo. -->
  <env name="QT_QPA_PLATFORM" value="xcb"/>

  <include file="$(find sar_yolo_detector)/launch/xd_yolo_multi_source_detection_integration.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="config" value="$(arg detector_config)"/>
    <arg name="overlay_config" value="$(arg detector_overlay_config)"/>
    <arg name="model_path" value="$(arg model_path)"/>
    <arg name="model_sha256" value="$(arg model_sha256)"/>
    <arg name="model_version" value="$(arg model_version)"/>
    <arg name="inference_backend" value="$(arg inference_backend)"/>
    <arg name="engine_path" value="$(arg engine_path)"/>
    <arg name="engine_sha256" value="$(arg engine_sha256)"/>
    <arg name="engine_source_model_sha256" value="$(arg engine_source_model_sha256)"/>
    <arg name="auto_export_engine" value="$(arg auto_export_engine)"/>
    <arg name="engine_cache_dir" value="$(arg engine_cache_dir)"/>
    <arg name="engine_builder_optimization_level" value="$(arg engine_builder_optimization_level)"/>
    <arg name="engine_image_size" value="$(arg engine_image_size)"/>
    <arg name="engine_workspace_gib" value="$(arg engine_workspace_gib)"/>
    <arg name="maximum_batch_size" value="$(arg maximum_batch_size)"/>
    <arg name="pixel_assist_enabled" value="$(arg pixel_assist_enabled)"/>
    <arg name="pixel_assist_hint_timeout_sec" value="2.2"/>
    <arg name="pixel_assist_confidence" value="0.45"/>
    <arg name="use_gpu" value="$(arg use_gpu)"/>
    <arg name="fixed_image_topic" value="fixed_camera/image_raw"/>
    <!-- No publisher on this input in fixed-camera-only mode. -->
    <arg name="gimbal_image_topic" value="gimbal_camera/disabled_image"/>
    <arg name="fixed_output_topic" value="detect/input/fixed/detections_2d"/>
    <arg name="gimbal_output_topic" value="detect/input/gimbal/detections_2d"/>
    <arg name="fixed_image_source" value="benchmark_fixed"/>
    <!-- The two target lanes occupy the central-left camera footprint. The
         right-hand tree is scenery, not part of this benchmark detection area. -->
    <arg name="fixed_detection_area" value="[0.06, 0.05, 0.73, 0.98]"/>
    <arg name="gimbal_image_source" value="benchmark_gimbal"/>
    <arg name="fixed_sensor_id" value="benchmark_fixed_camera"/>
    <arg name="gimbal_sensor_id" value="benchmark_gimbal_camera"/>
    <arg name="reid_enabled" value="$(arg enable_reid)"/>
    <arg name="fixed_reid_profile" value="$(arg fixed_reid_profile)"/>
    <arg name="tracking_tracks_topic" value="track/tracks"/>
    <!-- Keep the stable 4 Hz detector cap; the 6 Hz overlay performs
         per-target pixel tracking between detector frames. Full-camera-rate
         YOLO increased identity churn in the 45 s turn regression. -->
    <arg name="discovery_max_fps" value="$(arg camera_detection_max_fps)"/>
    <arg name="priority_max_fps" value="$(arg camera_detection_max_fps)"/>
    <arg name="standby_max_fps" value="$(arg camera_detection_max_fps)"/>
  </include>

  <!-- The fixed camera uses calibrated 2D-to-ground projection; this node
       never consumes Gazebo target truth. -->
  <include file="$(find xd_uav_track)/launch/detect_instance.launch">
    <arg name="UAV_NAME" value="$(arg UAV_NAME)"/>
    <arg name="config" value="$(find xd_uav_track)/config/tracking_benchmark_ground_projection.yaml"/>
    <arg name="node_name" value="fixed_camera_ground_projection"/>
    <arg name="body_frame" value="tracking_benchmark/metric_origin"/>
    <arg name="world_frame" value="world"/>
    <arg name="image_source" value="benchmark_fixed"/>
    <arg name="sensor_id" value="benchmark_fixed_camera"/>
    <arg name="detector_name" value="sar_yolo_detector"/>
    <arg name="image_topic" value="fixed_camera/image_raw"/>
    <arg name="camera_info_topic" value="fixed_camera/camera_info"/>
    <arg name="detections_2d_topic" value="detect/input/fixed/detections_2d"/>
    <arg name="detections_3d_topic" value="track/detections"/>
    <arg name="status_topic" value="detect/fixed_ground_projection/status"/>
  </include>
  <group ns="$(arg UAV_NAME)">
    <node pkg="xd_uav_track" type="xd_uav_track_node" name="track" output="screen"
          clear_params="true">
      <rosparam command="load" file="$(arg track_config)"/>
      <rosparam command="load" file="$(arg benchmark_config)"/>
      <param name="frames/body" value="tracking_benchmark/metric_origin"/>
    </node>

    <node pkg="xd_uav_track" type="tracking_overlay_node.py" name="fixed_tracking_overlay" output="screen">
      <param name="image_source" value="benchmark_fixed"/>
      <param name="show_confirmed_only" value="true"/>
      <param name="show_selected_lost" value="true"/>
      <param name="selected_lost_max_frames" value="3"/>
      <param name="input_image_topic" value="fixed_camera/image_raw"/>
      <param name="tracks_topic" value="track/tracks_by_source"/>
      <param name="status_topic" value="track/status"/>
      <param name="output_image_topic" value="fixed_camera/tracking_overlay"/>
      <param name="display_rate_hz" value="$(arg overlay_display_rate_hz)"/>
      <param name="maximum_pair_delta_sec" value="$(arg overlay_maximum_pair_delta_sec)"/>
    </node>
    <node if="$(arg show_overlay)" pkg="rqt_image_view" type="rqt_image_view"
          name="fixed_tracking_overlay_view"
          args="/tracking_benchmark/fixed_camera/tracking_overlay"
          output="screen"/>
  </group>
</launch>
