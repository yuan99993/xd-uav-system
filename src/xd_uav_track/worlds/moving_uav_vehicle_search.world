<?xml version="1.0"?>
<sdf version="1.6">
  <world name="moving_uav_vehicle_search">
    <gravity>0 0 -9.81</gravity>
    <physics name="low_load_physics" type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_update_rate>100</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <scene>
      <ambient>0.58 0.59 0.57 1</ambient>
      <background>0.70 0.73 0.76 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 60 0.35 0.15 0</pose>
      <diffuse>0.92 0.90 0.84 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <direction>-0.35 0.20 -0.91</direction>
    </light>
    <!-- Uniform concrete-colored ground, with no checker texture or clutter. -->
    <model name="concrete_ground">
      <static>true</static>
      <link name="ground">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>110 82</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>110 82</size></plane></geometry>
          <material><ambient>0.55 0.56 0.54 1</ambient><diffuse>0.62 0.63 0.61 1</diffuse></material>
        </visual>
      </link>
    </model>

    <include><uri>model://search_quadrotor</uri><name>search_quadrotor</name><pose>-34 -21 22 0 0 0</pose></include>
    <include><uri>model://tracking_tank</uri><name>search_vehicle_alpha</name><pose>-30 -18 0 0 0 0</pose></include>
    <include><uri>model://tracking_tank</uri><name>search_vehicle_bravo</name><pose>30 2 0 0 0 3.14159265359</pose></include>
    <include><uri>model://tracking_tank</uri><name>search_vehicle_charlie</name><pose>5 14 0 0 0 0</pose></include>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -42 52 0.86 0 1.57079632679</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
