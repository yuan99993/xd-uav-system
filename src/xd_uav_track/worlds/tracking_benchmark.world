<?xml version="1.0"?>
<sdf version="1.6">
  <!--
    Self-contained, deliberately low-load two-target tracking scene. Both
    tanks are moved by tracking_benchmark_driver.py, which publishes their
    public identities and pose ground truth. No occluders are present.
  -->
  <world name="tracking_benchmark">
    <physics name="ode" type="ode">
      <max_step_size>0.008</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>125</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.50 0.50 0.51 1</ambient>
      <background>0.50 0.59 0.67 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.94 0.94 0.92 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <direction>-0.35 0.15 -0.92</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="benchmark_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <!-- Neutral light concrete keeps the tank silhouettes and markings distinct. -->
        <visual name="ground"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.49 0.50 0.51 1</ambient><diffuse>0.73 0.74 0.75 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Two large, pointed, low-poly rock hills sit outside the tank lanes. -->
    <include><uri>model://tracking_mountain</uri><name>benchmark_mountain_west</name><pose>-34 8 0 0 0 0</pose></include>
    <include><uri>model://tracking_mountain</uri><name>benchmark_mountain_east</name><pose>34 12 0 0 0 0</pose></include>

    <include><uri>model://tracking_tank</uri><name>benchmark_tank_alpha</name><pose>-8.5 -11 0 0 0 1.57079632679</pose></include>
    <include><uri>model://tracking_tank</uri><name>benchmark_tank_bravo</name><pose>-8.5 5 0 0 0 1.57079632679</pose></include>

    <!--
      South fixed camera: a deliberately wide-area search camera.  The higher
      mounting point sees the target route without raising image resolution.
    -->
    <model name="benchmark_fixed_camera">
      <static>true</static>
      <pose>0 -27 29 0 0.872664626 1.57079632679</pose>
      <link name="fixed_camera_link">
        <visual name="body"><geometry><box><size>0.8 0.8 0.5</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.16 0.16 0.16 1</diffuse></material></visual>
        <sensor name="fixed_camera_sensor" type="camera">
          <always_on>true</always_on><update_rate>6</update_rate><visualize>false</visualize>
          <camera><horizontal_fov>1.40</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>120</far></clip></camera>
          <plugin name="benchmark_fixed_camera_ros" filename="libgazebo_ros_camera.so">
            <robotNamespace>/tracking_benchmark</robotNamespace><cameraName>fixed_camera</cameraName><imageTopicName>image_raw</imageTopicName><cameraInfoTopicName>camera_info</cameraInfoTopicName><frameName>tracking_benchmark/fixed_camera_optical_frame</frameName><updateRate>6</updateRate>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Retain the co-mounted gimbal housing as a scene prop; its camera sensor
         and ROS plugin are intentionally suspended in fixed-camera-only mode. -->
    <model name="benchmark_gimbal_camera">
      <static>true</static>
      <pose>0.35 -27 28.85 0 0.67474094222 3.14159265359</pose>
      <link name="gimbal_camera_link">
        <visual name="body"><geometry><sphere><radius>0.48</radius></sphere></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.10 0.10 0.10 1</diffuse></material></visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="benchmark_overview">
        <pose>0 -64 64 0 0.78539816339 1.57079632679</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
