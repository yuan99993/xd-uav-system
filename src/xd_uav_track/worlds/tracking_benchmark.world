<?xml version="1.0"?>
<sdf version="1.6">
  <!--
    Self-contained, deliberately low-load visual tracking scene.  Targets are
    moved by tracking_benchmark_driver.py; Gazebo renders actual occlusion,
    while that node publishes the public-ID/pose ground truth separately.
  -->
  <world name="tracking_benchmark">
    <physics name="ode" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.48 0.48 0.48 1</ambient>
      <background>0.42 0.56 0.72 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.92 0.90 0.78 1</diffuse>
      <specular>0.18 0.18 0.18 1</specular>
      <direction>-0.35 0.15 -0.92</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="benchmark_ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="ground"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.18 0.24 0.12 1</ambient><diffuse>0.26 0.34 0.17 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Visual road strips make the trajectories and right-angle turn easy to inspect. -->
    <model name="road_east_west"><static>true</static><link name="link"><visual name="road"><pose>0 -9 0.012 0 0 0</pose><geometry><box><size>58 4 0.025</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material></visual></link></model>
    <model name="road_north_south"><static>true</static><link name="link"><visual name="road"><pose>-8 1.5 0.014 0 0 0</pose><geometry><box><size>4 29 0.028</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.28 0.28 0.28 1</diffuse></material></visual></link></model>

    <!-- Four opaque panels create deterministic 1/3/5/10 s fixed-camera occlusion windows. -->
    <model name="occluder_1s"><static>true</static><link name="link"><visual name="wall"><pose>-12 -0.75 3.8 0 0 0</pose><geometry><box><size>5.6 0.38 7.6</size></box></geometry><material><ambient>0.32 0.30 0.24 1</ambient><diffuse>0.46 0.42 0.32 1</diffuse></material></visual><collision name="collision"><pose>-12 -0.75 3.8 0 0 0</pose><geometry><box><size>5.6 0.38 7.6</size></box></geometry></collision></link></model>
    <model name="occluder_3s"><static>true</static><link name="link"><visual name="wall"><pose>-4 -0.75 3.8 0 0 0</pose><geometry><box><size>5.6 0.38 7.6</size></box></geometry><material><ambient>0.32 0.30 0.24 1</ambient><diffuse>0.46 0.42 0.32 1</diffuse></material></visual><collision name="collision"><pose>-4 -0.75 3.8 0 0 0</pose><geometry><box><size>5.6 0.38 7.6</size></box></geometry></collision></link></model>
    <model name="occluder_5s"><static>true</static><link name="link"><visual name="wall"><pose>4 -0.75 3.8 0 0 0</pose><geometry><box><size>5.6 0.38 7.6</size></box></geometry><material><ambient>0.32 0.30 0.24 1</ambient><diffuse>0.46 0.42 0.32 1</diffuse></material></visual><collision name="collision"><pose>4 -0.75 3.8 0 0 0</pose><geometry><box><size>5.6 0.38 7.6</size></box></geometry></collision></link></model>
    <model name="occluder_10s"><static>true</static><link name="link"><visual name="wall"><pose>13 -0.75 3.8 0 0 0</pose><geometry><box><size>5.6 0.38 7.6</size></box></geometry><material><ambient>0.32 0.30 0.24 1</ambient><diffuse>0.46 0.42 0.32 1</diffuse></material></visual><collision name="collision"><pose>13 -0.75 3.8 0 0 0</pose><geometry><box><size>5.6 0.38 7.6</size></box></geometry></collision></link></model>

    <!-- Extra buildings provide off-axis background clutter without blocking the gimbal side-view. -->
    <model name="warehouse_west"><static>true</static><link name="link"><visual name="building"><pose>-28 8 5 0 0 0</pose><geometry><box><size>12 9 10</size></box></geometry><material><ambient>0.34 0.36 0.39 1</ambient><diffuse>0.48 0.51 0.55 1</diffuse></material></visual></link></model>
    <model name="warehouse_east"><static>true</static><link name="link"><visual name="building"><pose>28 12 4 0 0 0</pose><geometry><box><size>10 10 8</size></box></geometry><material><ambient>0.34 0.36 0.39 1</ambient><diffuse>0.48 0.51 0.55 1</diffuse></material></visual></link></model>

    <include><uri>model://tracking_tank</uri><name>benchmark_tank_alpha</name><pose>-8.5 -11 0 0 0 0</pose></include>
    <include><uri>model://tracking_tank</uri><name>benchmark_tank_bravo</name><pose>0 -9 0 0 0 0</pose></include>
    <include><uri>model://tracking_armored_decoy</uri><name>benchmark_armored_decoy</name><pose>18 -14 0 0 0 3.14159265359</pose></include>

    <!--
      South fixed camera: a deliberately wide-area search camera.  The higher
      mounting point sees the whole manoeuvre area without raising image
      resolution (and therefore without adding CUDA/Gazebo load).  The gimbal
      below retains a tighter view for identification when a target is found.
      The four panels block this fixed-camera view.
    -->
    <model name="benchmark_fixed_camera">
      <static>true</static>
      <pose>0 -32 32 0 0.78539816339 1.57079632679</pose>
      <link name="fixed_camera_link">
        <visual name="body"><geometry><box><size>0.8 0.8 0.5</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.16 0.16 0.16 1</diffuse></material></visual>
        <sensor name="fixed_camera_sensor" type="camera">
          <always_on>true</always_on><update_rate>12</update_rate><visualize>false</visualize>
          <camera><horizontal_fov>1.40</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>120</far></clip></camera>
          <plugin name="benchmark_fixed_camera_ros" filename="libgazebo_ros_camera.so">
            <robotNamespace>/tracking_benchmark</robotNamespace><cameraName>fixed_camera</cameraName><imageTopicName>image_raw</imageTopicName><cameraInfoTopicName>camera_info</cameraInfoTopicName><frameName>tracking_benchmark/fixed_camera_optical_frame</frameName><updateRate>12</updateRate>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- The driver rotates this side-view camera toward alpha, emulating a tracking gimbal. -->
    <model name="benchmark_gimbal_camera">
      <static>false</static>
      <pose>25 0 20 0 0.67474094222 3.14159265359</pose>
      <link name="gimbal_camera_link">
        <gravity>false</gravity><self_collide>false</self_collide><kinematic>false</kinematic>
        <inertial><mass>1.0</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <visual name="body"><geometry><sphere><radius>0.48</radius></sphere></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.10 0.10 0.10 1</diffuse></material></visual>
        <sensor name="gimbal_camera_sensor" type="camera">
          <always_on>true</always_on><update_rate>12</update_rate><visualize>false</visualize>
          <camera><horizontal_fov>0.90</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>120</far></clip></camera>
          <plugin name="benchmark_gimbal_camera_ros" filename="libgazebo_ros_camera.so">
            <robotNamespace>/tracking_benchmark</robotNamespace><cameraName>gimbal_camera</cameraName><imageTopicName>image_raw</imageTopicName><cameraInfoTopicName>camera_info</cameraInfoTopicName><frameName>tracking_benchmark/gimbal_camera_optical_frame</frameName><updateRate>12</updateRate>
          </plugin>
        </sensor>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="benchmark_overview">
        <pose>0 -48 48 0 0.78539816339 1.57079632679</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>
  </world>
</sdf>
