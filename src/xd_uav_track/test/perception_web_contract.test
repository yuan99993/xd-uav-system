<launch>
  <include file="$(find sar_yolo_detector)/launch/xd_yolo_multi_source_detection_integration.launch">
    <arg name="UAV_NAME" value="web_contract_test"/>
    <arg name="reid_enabled" value="false"/>
    <arg name="pause_without_subscribers" value="false"/>
    <arg name="discovery_max_fps" value="2"/>
  </include>
  <group ns="web_contract_test">
    <node pkg="xd_uav_track" type="xd_uav_track_node" name="track" output="screen">
      <rosparam command="load" file="$(find xd_uav_track)/config/track.yaml"/>
      <param name="runtime/publish_control_reference" value="false"/>
      <param name="tracker/selection/auto_select" value="false"/>
    </node>
    <node pkg="xd_uav_track" type="perception_mode_manager.py" name="mode_manager" output="screen">
      <rosparam param="sources">
        - image_source: fixed_rgb
          image_topic: fixed_camera/image_raw
        - image_source: gimbal_rgb
          image_topic: gimbal_camera/image_raw
      </rosparam>
    </node>
  </group>
  <include file="$(find xd_uav_track)/launch/perception_web_bridge.launch">
    <arg name="UAV_NAME" value="web_contract_test"/>
    <arg name="port" value="24177"/>
  </include>
  <test test-name="websocket_contract" pkg="xd_uav_track" type="test_perception_web_ros.py" time-limit="100"/>
</launch>
