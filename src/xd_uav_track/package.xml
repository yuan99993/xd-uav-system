<?xml version="1.0"?>
<package format="2">
  <name>xd_uav_track</name>
  <version>1.0.0</version>
  <description>Bounding-box tracking guidance for the XD UAV control stack.</description>

  <maintainer email="kzy@example.com">kzy</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>eigen</depend>
  <depend>mavros_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>rosnode</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xd_uav_state_estimators</exec_depend>
  <exec_depend>xd_uav_control_manager</exec_depend>
  <exec_depend>xd_uav_world_tf_manager</exec_depend>
  <exec_depend>xd_uav_single_tf_manager</exec_depend>
  <exec_depend>xd_uav_detect</exec_depend>
  <exec_depend>sar_yolo_detector</exec_depend>

  <test_depend>gtest</test_depend>

  <export/>
</package>
