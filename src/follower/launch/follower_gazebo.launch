<launch>
  <!--
    follower_gazebo.launch — Follower + Gazebo + PX4 SITL 仿真启动文件

    同时启动:
    - MAVROS (PX4 通信桥)
    - Tracker 节点 (目标检测/跟踪)
    - Follower 节点 (目标跟随控制)

    用于完整的 Gazebo SITL 目标跟踪仿真。
  -->

  <!-- ── MAVROS ────────────────────────────────────────────────────────── -->
  <arg name="fcu_url"               default="udp://:14540@localhost:14557" />
  <arg name="gcs_url"               default="" />
  <arg name="tgt_system"            default="1" />
  <arg name="tgt_component"         default="1" />

  <!-- ── Tracker ───────────────────────────────────────────────────────── -->
  <arg name="tracker_frame_width"   default="640" />
  <arg name="tracker_frame_height"  default="480" />
  <arg name="tracker_publish_rate"  default="30.0" />

  <!-- ── Follower ──────────────────────────────────────────────────────── -->
  <arg name="lateral_guidance_mode" default="coordinated_turn" />
  <arg name="max_forward_velocity"  default="5.0" />
  <arg name="publish_rate"          default="60.0" />

  <!-- ── 启动 MAVROS ───────────────────────────────────────────────────── -->
  <include file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url"       value="$(arg fcu_url)" />
    <arg name="gcs_url"       value="$(arg gcs_url)" />
    <arg name="tgt_system"    value="$(arg tgt_system)" />
    <arg name="tgt_component" value="$(arg tgt_component)" />
  </include>

  <!-- ── 启动 Tracker ──────────────────────────────────────────────────── -->
  <include file="$(find tracker)/launch/tracker.launch">
    <arg name="frame_width"  value="$(arg tracker_frame_width)" />
    <arg name="frame_height" value="$(arg tracker_frame_height)" />
    <arg name="publish_rate" value="$(arg tracker_publish_rate)" />
  </include>

  <!-- ── 启动 Follower ─────────────────────────────────────────────────── -->
  <include file="$(find follower)/launch/follower.launch">
    <arg name="lateral_guidance_mode" value="$(arg lateral_guidance_mode)" />
    <arg name="max_forward_velocity"  value="$(arg max_forward_velocity)" />
    <arg name="publish_rate"          value="$(arg publish_rate)" />
  </include>

</launch>
