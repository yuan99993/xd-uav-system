<launch>
  <!--
    follower.launch — Follower 功能包启动文件
    MRS-style launch file for the Follower ROS package.

    启动 Follower 节点，接收 Tracker 归一化误差，
    计算 PX4 Offboard 控制速度指令。

    依赖:
      - tracker 功能包 (/tracker_node/normalized_error)
      - MAVROS (/mavros/* topics)
  -->

  <!-- ── 控制模式 ──────────────────────────────────────────────────────── -->
  <arg name="config" default="$(find follower)/config/follower_params.yaml" />
  <arg name="lateral_guidance_mode"     default="coordinated_turn" />
  <arg name="enable_auto_mode_switching" default="false" />

  <!-- ── 发布参数 ──────────────────────────────────────────────────────── -->
  <arg name="publish_rate"              default="60.0" />

  <!-- ── 速度限制 ──────────────────────────────────────────────────────── -->
  <arg name="max_velocity_forward"      default="8.0" />
  <arg name="max_velocity_lateral"      default="3.0" />
  <arg name="max_velocity_vertical"     default="2.0" />
  <arg name="max_yaw_rate_deg_s"        default="90.0" />

  <!-- ── 前向速度 ──────────────────────────────────────────────────────── -->
  <arg name="max_forward_velocity"      default="5.0" />
  <arg name="forward_ramp_rate"         default="0.5" />

  <!-- ── PID ───────────────────────────────────────────────────────────── -->
  <arg name="pid_yaw_kp"                default="2.0" />
  <arg name="pid_yaw_ki"                default="0.05" />
  <arg name="pid_yaw_kd"                default="0.1" />
  <arg name="pid_down_kp"               default="1.0" />
  <arg name="pid_down_ki"               default="0.03" />
  <arg name="pid_down_kd"               default="0.05" />

  <!-- ── 特性开关 ──────────────────────────────────────────────────────── -->
  <arg name="adaptive_dive_climb_enabled" default="false" />
  <arg name="pitch_compensation_enabled"  default="false" />

  <!-- ── 环境变量 ──────────────────────────────────────────────────────── -->
  <env name="PYTHONNOUSERSITE" value="1" />

  <!-- ── 节点定义 ──────────────────────────────────────────────────────── -->
  <node name="follower_node" pkg="follower" type="follower_node" output="screen"
        required="false">

    <!-- 产品安全默认值；下方 launch 参数仅覆盖常用调参项。 -->
    <rosparam command="load" file="$(arg config)" />

    <!-- 控制模式 -->
    <param name="lateral_guidance_mode"      value="$(arg lateral_guidance_mode)" />
    <param name="enable_auto_mode_switching"  value="$(arg enable_auto_mode_switching)" />

    <!-- 发布频率 -->
    <param name="publish_rate"               value="$(arg publish_rate)" />

    <!-- 速度限制 -->
    <param name="max_velocity_forward"       value="$(arg max_velocity_forward)" />
    <param name="max_velocity_lateral"       value="$(arg max_velocity_lateral)" />
    <param name="max_velocity_vertical"      value="$(arg max_velocity_vertical)" />
    <param name="max_yaw_rate_deg_s"         value="$(arg max_yaw_rate_deg_s)" />

    <!-- 前向速度 -->
    <param name="max_forward_velocity"       value="$(arg max_forward_velocity)" />
    <param name="forward_ramp_rate"          value="$(arg forward_ramp_rate)" />

    <!-- PID -->
    <param name="pid_yaw"  value="{'kp': $(arg pid_yaw_kp), 'ki': $(arg pid_yaw_ki), 'kd': $(arg pid_yaw_kd)}" />
    <param name="pid_down" value="{'kp': $(arg pid_down_kp), 'ki': $(arg pid_down_ki), 'kd': $(arg pid_down_kd)}" />

    <!-- 特性 -->
    <param name="adaptive_dive_climb_enabled" value="$(arg adaptive_dive_climb_enabled)" />
    <param name="pitch_compensation_enabled"  value="$(arg pitch_compensation_enabled)" />

  </node>

</launch>
