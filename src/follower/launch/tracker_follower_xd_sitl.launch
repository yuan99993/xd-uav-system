<?xml version="1.0"?>
<launch>
  <!-- PX4/Gazebo SITL wrapper for the complete XD tracking control chain. -->
  <arg name="UAV_NAME" default="uav1"/>
  <arg name="vehicle" default="iris"/>
  <arg name="vehicle_type" default="multirotor"/>
  <arg name="tracking_system_launch"
       default="tracker_follower_xd_system.launch"/>
  <arg name="follower_profile" default=""/>
  <arg name="start_tracker" default="true"/>
  <arg name="estimator" default="ekf2"/>
  <arg name="world"
       default="$(find mavlink_sitl_gazebo)/worlds/empty.world"/>
  <arg name="vehicle_model_root"
       default="$(find mavlink_sitl_gazebo)/models"/>
  <arg name="vehicle_plugin_root" default="/opt/ros/noetic/lib"/>
  <arg name="gui" default="false"/>
  <arg name="paused" default="false"/>
  <arg name="fcu_url" default="udp://:14540@localhost:14557"/>

  <param name="/use_sim_time" value="true"/>
  <env name="PYTHONNOUSERSITE" value="1"/>
  <env name="GAZEBO_MODEL_DATABASE_URI" value=""/>
  <env name="GAZEBO_MODEL_PATH"
       value="$(arg vehicle_model_root):$(find mavlink_sitl_gazebo)/models"/>
  <env name="GAZEBO_PLUGIN_PATH"
       value="$(arg vehicle_plugin_root):/opt/ros/noetic/lib"/>

  <!--
    Start Gazebo before PX4.  On slower/WSL hosts the upstream
    posix_sitl.launch starts PX4 first; the simulator client can then miss
    Gazebo's TCP 4560 listener and leave the vehicle armed without motor
    commands.  The short PX4 delay removes that startup race.
  -->
  <env name="PX4_SIM_MODEL" value="$(arg vehicle)"/>
  <env name="PX4_ESTIMATOR" value="$(arg estimator)"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
  </include>

  <!--
    The packaged PX4 1.13/Gazebo combination can deadlock after the first
    93-byte simulator exchange when lockstep is enabled under WSL.  Generate
    the test model in a ROS parameter with lockstep disabled, without
    modifying the system-installed iris model.
  -->
  <param name="xd_sitl_vehicle_sdf"
         command="sed -e 's#&lt;enable_lockstep&gt;1&lt;/enable_lockstep&gt;#&lt;enable_lockstep&gt;0&lt;/enable_lockstep&gt;#' -e 's#&lt;enable_lockstep&gt;true&lt;/enable_lockstep&gt;#&lt;enable_lockstep&gt;false&lt;/enable_lockstep&gt;#' -e 's#&lt;use_tcp&gt;1&lt;/use_tcp&gt;#&lt;use_tcp&gt;0&lt;/use_tcp&gt;#' -e 's#&lt;use_tcp&gt;true&lt;/use_tcp&gt;#&lt;use_tcp&gt;false&lt;/use_tcp&gt;#' -e '/&lt;motorSpeedPubTopic&gt;/a\      &lt;enableMotorCrash&gt;false&lt;/enableMotorCrash&gt;' $(arg vehicle_model_root)/$(arg vehicle)/$(arg vehicle).sdf"/>

  <node name="vehicle_spawn"
        pkg="gazebo_ros"
        type="spawn_model"
        output="screen"
        args="-sdf -param xd_sitl_vehicle_sdf -model $(arg vehicle)"/>

  <node name="sitl"
        pkg="follower"
        type="start_px4_sitl_udp"
        output="screen"
        required="true"
        args="14560"/>

  <!-- Keep every MAVROS endpoint under /<UAV_NAME>/mavros. -->
  <group ns="$(arg UAV_NAME)">
    <include file="$(find mavros)/launch/px4.launch">
      <arg name="fcu_url" value="$(arg fcu_url)"/>
      <arg name="gcs_url" value=""/>
    </include>
  </group>

  <!-- Match the XD estimator/control-state body frame exactly. -->
  <param name="/$(arg UAV_NAME)/mavros/imu/frame_id"
         value="$(arg UAV_NAME)/base_link"/>

  <!-- Start the XD stack only after PX4 UDP sensors and EKF are live. -->
  <node name="xd_tracking_stack"
        pkg="follower"
        type="start_xd_tracking_stack"
        output="screen"
        args="15 $(arg UAV_NAME) $(arg vehicle_type) /$(arg UAV_NAME)/mavros $(arg tracking_system_launch) $(arg follower_profile) $(arg start_tracker)"/>
</launch>
