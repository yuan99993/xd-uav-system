<launch>
  <arg name="profile_group" default="all"/>
  <node pkg="follower" type="follower_node" name="profile_velocity_test" output="screen">
    <param name="tracker_error_topic" value="/profile_test/error"/>
    <param name="altitude_fail_safe" value="false"/>
    <param name="enable_mavros_output" value="false"/>
    <param name="enable_mrs_velocity_reference" value="false"/>
    <param name="follower_profile" value="mc_velocity_chase"/>
  </node>
  <node pkg="follower" type="follower_node" name="profile_attitude_test" output="screen">
    <param name="tracker_error_topic" value="/profile_test/error"/>
    <param name="altitude_fail_safe" value="false"/>
    <param name="enable_mavros_output" value="false"/>
    <param name="enable_mrs_velocity_reference" value="false"/>
    <param name="allow_attitude_rate_profiles" value="true"/>
    <param name="allow_fixed_wing_profile" value="true"/>
    <param name="target_loss_timeout" value="0.4"/>
    <param name="follower_profile" value="mc_attitude_rate"/>
  </node>
  <node pkg="follower" type="xd_controller_reference_adapter_node"
        name="profile_attitude_xd_adapter" output="screen">
    <param name="command_topic" value="/profile_attitude_test/follower_command"/>
    <param name="state_topic" value="/profile_test/state"/>
    <param name="reference_topic" value="/profile_test/attitude_reference"/>
  </node>
  <node pkg="follower" type="xd_controller_reference_adapter_node"
        name="profile_velocity_xd_adapter" output="screen">
    <param name="command_topic" value="/profile_velocity_test/follower_command"/>
    <param name="state_topic" value="/profile_test/state"/>
    <param name="reference_topic" value="/profile_test/velocity_reference"/>
  </node>
  <test test-name="follower_profiles" pkg="follower"
        type="test_follower_profiles.py" time-limit="45">
    <param name="profile_group" value="$(arg profile_group)"/>
  </test>
</launch>
