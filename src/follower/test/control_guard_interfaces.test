<launch>
  <node pkg="follower" type="follower_node" name="follower_guard_test"
        output="screen" required="true">
    <param name="tracker_error_topic" value="/follower_guard_test/error" />
    <param name="gimbal_state_topic" value="/follower_guard_test/gimbal_state" />
    <param name="require_gimbal_state_for_control" value="true" />
    <param name="publish_rate" value="50.0" />
    <param name="altitude_fail_safe" value="false" />
    <param name="control_output_backend" value="command_only" />
    <param name="require_control_lease" value="true" />
    <param name="minimum_control_lease_sec" value="0.10" />
    <param name="maximum_control_lease_sec" value="2.0" />
    <param name="require_capture_timestamp" value="true" />
    <param name="enable_mavros_output" value="false" />
    <param name="enable_mrs_velocity_reference" value="false" />
  </node>
  <node pkg="follower" type="follower_node" name="follower_mavros_body_test"
        output="screen" required="true">
    <param name="tracker_error_topic" value="/body_test/error" />
    <param name="publish_rate" value="50.0" />
    <param name="altitude_fail_safe" value="false" />
    <param name="lateral_guidance_mode" value="sideslip" />
    <param name="control_output_backend" value="mavros_body" />
    <param name="require_control_lease" value="false" />
    <param name="require_capture_timestamp" value="true" />
    <param name="mavros_namespace" value="/body_test/mavros" />
    <param name="mavros_body_velocity_topic" value="/body_test/setpoint" />
    <param name="required_mavros_mode" value="OFFBOARD" />
  </node>
  <test test-name="follower_control_guard_interfaces" pkg="follower"
        type="test_control_guard_interfaces.py" time-limit="30" />
</launch>
