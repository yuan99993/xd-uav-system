Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
  - Class: rviz/Time
    Name: Time
Visualization Manager:
  Displays:
    # ── Grid ────────────────────────────────────────────────────────────
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Cell Size: 1
      Color: 160; 160; 164
      Alpha: 0.5

    # ── RobotModel (drone) ──────────────────────────────────────────────
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true

    # ── TF ──────────────────────────────────────────────────────────────
    - Class: rviz/TF
      Name: TF
      Enabled: false
      Show Axes: false
      Show Arrows: false
      Marker Scale: 0.3

    # ── MAVROS Local Position (PoseStamped) ──────────────────────────────
    - Class: rviz/Pose
      Name: MAVROS Estimated Pose
      Enabled: false
      Topic: /mavros/local_position/pose
      Color: 0; 255; 0
      Alpha: 0.8
      Shaft Length: 0.5
      Shaft Radius: 0.05
      Head Length: 0.15
      Head Radius: 0.08

    # ── Follower Velocity Command ───────────────────────────────────────
    - Class: rviz/Marker
      Name: Velocity Command
      Enabled: true
      Marker Topic: /follower_node/velocity_command_marker
      Queue Size: 10

    # ── MAVROS Feedback Velocity ───────────────────────────────────────
    - Class: rviz/Marker
      Name: Actual Velocity (MAVROS)
      Enabled: true
      Marker Topic: /follower_node/actual_velocity_marker
      Queue Size: 10

    # ── MAVROS Odometry (velocity) ──────────────────────────────────────
    - Class: rviz/Odometry
      Name: Drone Odometry
      Enabled: false
      Topic: /mavros/local_position/odom
      Color: 100; 200; 255
      Alpha: 0.6
      Shaft Length: 0.3
      Shaft Radius: 0.03
      Head Length: 0.1
      Head Radius: 0.06

  # ── Views ─────────────────────────────────────────────────────────────
  Views:
    - Class: rviz/Orbit
      Name: Top-down View
      Target Frame: map
      Distance: 30
      Pitch: 1.57
      Yaw: 0
    - Class: rviz/Orbit
      Name: Chase View
      Target Frame: base_link
      Distance: 10
      Pitch: 0.5
      Yaw: 0
    - Class: rviz/Orbit
      Name: Current View
      Target Frame: map
      Distance: 20
      Pitch: 0.8
      Yaw: 0

  # ── Global Options ────────────────────────────────────────────────────
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 48; 48; 48

  Window Geometry:
    Height: 800
    Width: 1200
