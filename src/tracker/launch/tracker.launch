<launch>
  <!--
    tracker.launch — Tracker 功能包启动文件
    MRS-style launch file for the Tracker ROS package.

    启动 Tracker 节点，提供目标检测跟踪和归一化误差输出。
  -->

  <!-- ── 节点参数 ──────────────────────────────────────────────────────── -->
  <arg name="frame_width"       default="640" />
  <arg name="frame_height"      default="480" />
  <arg name="publish_rate"      default="30.0" />
  <arg name="tracker_name"      default="TrackerCore" />
  <arg name="image_source"      default="eo" />
  <arg name="allow_image_source_switch" default="false" />
  <arg name="require_image_source_metadata" default="false" />
  <arg name="direct_observation_hold_time" default="0.15" />

  <!-- ── 相机参数 ──────────────────────────────────────────────────────── -->
  <arg name="fov_horizontal"    default="60.0" />
  <arg name="fov_vertical"      default="45.0" />
  <arg name="mount_offset_yaw"   default="0.0" />
  <arg name="mount_offset_pitch" default="0.0" />
  <arg name="mount_offset_roll"  default="0.0" />
  <arg name="use_camera_info" default="true" />
  <arg name="camera_info_topic" default="/pod/camera/eo/camera_info" />
  <arg name="secondary_camera_info_topic" default="/pod/camera/ir/camera_info" />
  <arg name="use_dynamic_camera_tf" default="true" />
  <arg name="body_frame" default="base_link" />
  <arg name="tf_lookup_timeout_sec" default="0.02" />
  <arg name="gimbal_state_topic" default="/pod/gimbal/state" />
  <arg name="gimbal_state_timeout_sec" default="0.15" />
  <arg name="require_gimbal_state_for_body_los" default="false" />
  <arg name="selection_timestamp_tolerance_sec" default="0.25" />

  <!-- ── 跟踪参数 ──────────────────────────────────────────────────────── -->
  <arg name="enable_kalman_filter"       default="true" />
  <arg name="enable_motion_predictor"    default="true" />
  <arg name="enable_prediction_buffer"   default="true" />
  <arg name="id_loss_tolerance_frames"   default="5" />
  <arg name="spatial_iou_threshold"      default="0.35" />
  <arg name="tracking_strategy"          default="hybrid" />
  <arg name="tracker_profile"             default="smart_botsort" />
  <arg name="smart_tracker_backend"       default="botsort" />
  <arg name="reacquisition_mode"          default="balanced" />
  <arg name="enable_appearance_reid"      default="false" />
  <arg name="class_match_flexible"        default="true" />
  <arg name="bytetrack_high_confidence"   default="0.50" />
  <arg name="bytetrack_low_confidence"    default="0.10" />
  <arg name="bytetrack_low_iou_threshold" default="0.15" />
  <arg name="bytetrack_low_nis_scale"     default="2.0" />
  <arg name="enable_gmc"                  default="false" />
  <arg name="gmc_image_topic"             default="/camera/image_raw" />
  <arg name="gmc_max_features"            default="300" />
  <arg name="gmc_min_inliers"             default="12" />
  <arg name="gmc_ransac_reproj_threshold" default="3.0" />
  <arg name="gmc_max_image_width"         default="320" />
  <arg name="gmc_max_age_sec"             default="0.15" />
  <arg name="gmc_detection_sync_tolerance_sec" default="0.05" />
  <arg name="gmc_require_detection_sync" default="false" />
  <arg name="oosm_history_duration_sec"   default="0.5" />
  <arg name="oosm_max_future_sec"         default="0.02" />
  <arg name="oosm_max_snapshots"          default="40" />
  <arg name="target_size_ratio"          default="0.15" />
  <arg name="multi_track_confirmation_hits" default="2" />
  <arg name="multi_track_occlusion_frames" default="5" />
  <arg name="multi_track_removal_frames" default="30" />
  <arg name="multi_track_maximum_tracks" default="128" />
  <arg name="multi_track_maximum_embedding_dimension" default="2048" />
  <arg name="multi_track_new_confidence" default="0.20" />
  <arg name="multi_track_update_confidence" default="0.05" />
  <arg name="multi_track_iou_threshold" default="0.20" />
  <arg name="multi_track_center_distance" default="1.50" />
  <arg name="multi_track_appearance_cosine" default="0.78" />

  <!-- ── Kalman 参数 ───────────────────────────────────────────────────── -->
  <arg name="kalman_process_noise"       default="1.0" />
  <arg name="kalman_measurement_noise"   default="1.0" />

  <!-- ── 运动预测参数 ───────────────────────────────────────────────────── -->
  <arg name="velocity_alpha"             default="0.7" />
  <arg name="acceleration_alpha"         default="0.5" />

  <!-- ── 环境变量 ──────────────────────────────────────────────────────── -->
  <env name="PYTHONNOUSERSITE" value="1" />

  <!-- ── 节点定义 ──────────────────────────────────────────────────────── -->
  <node name="tracker_node" pkg="tracker" type="tracker_node" output="screen"
        required="false">

    <!-- Frame -->
    <param name="frame_width"      value="$(arg frame_width)" />
    <param name="frame_height"     value="$(arg frame_height)" />
    <param name="publish_rate"     value="$(arg publish_rate)" />
    <param name="tracker_name"     value="$(arg tracker_name)" />
    <param name="image_source"     value="$(arg image_source)" />
    <param name="allow_image_source_switch" value="$(arg allow_image_source_switch)" />
    <param name="require_image_source_metadata" value="$(arg require_image_source_metadata)" />
    <param name="direct_observation_hold_time" value="$(arg direct_observation_hold_time)" />

    <!-- Camera -->
    <param name="fov_horizontal"    value="$(arg fov_horizontal)" />
    <param name="fov_vertical"      value="$(arg fov_vertical)" />
    <param name="mount_offset_yaw"   value="$(arg mount_offset_yaw)" />
    <param name="mount_offset_pitch" value="$(arg mount_offset_pitch)" />
    <param name="mount_offset_roll"  value="$(arg mount_offset_roll)" />
    <param name="use_camera_info" value="$(arg use_camera_info)" />
    <param name="camera_info_topic" value="$(arg camera_info_topic)" />
    <param name="secondary_camera_info_topic" value="$(arg secondary_camera_info_topic)" />
    <param name="use_dynamic_camera_tf" value="$(arg use_dynamic_camera_tf)" />
    <param name="body_frame" value="$(arg body_frame)" />
    <param name="tf_lookup_timeout_sec" value="$(arg tf_lookup_timeout_sec)" />
    <param name="gimbal_state_topic" value="$(arg gimbal_state_topic)" />
    <param name="gimbal_state_timeout_sec" value="$(arg gimbal_state_timeout_sec)" />
    <param name="require_gimbal_state_for_body_los" value="$(arg require_gimbal_state_for_body_los)" />
    <param name="selection_timestamp_tolerance_sec" value="$(arg selection_timestamp_tolerance_sec)" />

    <!-- Tracking -->
    <param name="enable_kalman_filter"       value="$(arg enable_kalman_filter)" />
    <param name="enable_motion_predictor"    value="$(arg enable_motion_predictor)" />
    <param name="enable_prediction_buffer"   value="$(arg enable_prediction_buffer)" />
    <param name="id_loss_tolerance_frames"   value="$(arg id_loss_tolerance_frames)" />
    <param name="spatial_iou_threshold"      value="$(arg spatial_iou_threshold)" />
    <param name="tracking_strategy"          value="$(arg tracking_strategy)" />
    <param name="tracker_profile"             value="$(arg tracker_profile)" />
    <param name="smart_tracker_backend"       value="$(arg smart_tracker_backend)" />
    <param name="reacquisition_mode"          value="$(arg reacquisition_mode)" />
    <param name="enable_appearance_reid"      value="$(arg enable_appearance_reid)" />
    <param name="class_match_flexible"        value="$(arg class_match_flexible)" />
    <param name="bytetrack_high_confidence"   value="$(arg bytetrack_high_confidence)" />
    <param name="bytetrack_low_confidence"    value="$(arg bytetrack_low_confidence)" />
    <param name="bytetrack_low_iou_threshold" value="$(arg bytetrack_low_iou_threshold)" />
    <param name="bytetrack_low_nis_scale"     value="$(arg bytetrack_low_nis_scale)" />
    <param name="enable_gmc"                  value="$(arg enable_gmc)" />
    <param name="gmc_image_topic"             value="$(arg gmc_image_topic)" />
    <param name="gmc_max_features"            value="$(arg gmc_max_features)" />
    <param name="gmc_min_inliers"             value="$(arg gmc_min_inliers)" />
    <param name="gmc_ransac_reproj_threshold" value="$(arg gmc_ransac_reproj_threshold)" />
    <param name="gmc_max_image_width"         value="$(arg gmc_max_image_width)" />
    <param name="gmc_max_age_sec"             value="$(arg gmc_max_age_sec)" />
    <param name="gmc_detection_sync_tolerance_sec" value="$(arg gmc_detection_sync_tolerance_sec)" />
    <param name="gmc_require_detection_sync" value="$(arg gmc_require_detection_sync)" />
    <param name="oosm_history_duration_sec"   value="$(arg oosm_history_duration_sec)" />
    <param name="oosm_max_future_sec"         value="$(arg oosm_max_future_sec)" />
    <param name="oosm_max_snapshots"          value="$(arg oosm_max_snapshots)" />
    <param name="target_size_ratio"          value="$(arg target_size_ratio)" />
    <param name="multi_track_confirmation_hits" value="$(arg multi_track_confirmation_hits)" />
    <param name="multi_track_occlusion_frames" value="$(arg multi_track_occlusion_frames)" />
    <param name="multi_track_removal_frames" value="$(arg multi_track_removal_frames)" />
    <param name="multi_track_maximum_tracks" value="$(arg multi_track_maximum_tracks)" />
    <param name="multi_track_maximum_embedding_dimension" value="$(arg multi_track_maximum_embedding_dimension)" />
    <param name="multi_track_new_confidence" value="$(arg multi_track_new_confidence)" />
    <param name="multi_track_update_confidence" value="$(arg multi_track_update_confidence)" />
    <param name="multi_track_iou_threshold" value="$(arg multi_track_iou_threshold)" />
    <param name="multi_track_center_distance" value="$(arg multi_track_center_distance)" />
    <param name="multi_track_appearance_cosine" value="$(arg multi_track_appearance_cosine)" />

    <!-- Kalman -->
    <param name="kalman_process_noise"       value="$(arg kalman_process_noise)" />
    <param name="kalman_measurement_noise"   value="$(arg kalman_measurement_noise)" />

    <!-- Motion -->
    <param name="velocity_alpha"             value="$(arg velocity_alpha)" />
    <param name="acceleration_alpha"         value="$(arg acceleration_alpha)" />

  </node>

</launch>
